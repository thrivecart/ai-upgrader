  if [ -e "$STATE_YML" ] || [ -e "$STATE" ]; then
    info "Reinitializing; wiping visible state in $UPGRADE_DIR"
    wipe_upgrade_state
  fi
  private_init
  local key
  for key in FORMAT SKILL_ID SKILL_FILE SKILL_SHA256 PHASE MILESTONE_ID MILESTONE_AXIS MILESTONE_KIND MILESTONE_FROM MILESTONE_TO BASE_SHA HEAD_SHA LAST_KNOWN_GOOD_SHA MILESTONE_STATUS_VALUE FAST_GATE MILESTONE_GATE FULL_CI SMOKE_GATE REVIEW_STATUS REVIEW_SHA CURRENT_BUILD CURRENT_BUILD_SHA CURRENT_BUILD_WAIT_SCRIPT STOP_REQUESTED CURRENT_BLOCKER NEXT_ACTION APPROVED_PLAN_HASH AUTO_MODE UPGRADE_GOAL AUTO_ATTEMPTS TARGETS_AUTH_HASH; do unset "$key" || true; done
  state_defaults
  install_active_skill
  ensure_tables
  snapshot_git
  HEAD_SHA="$GIT_HEAD"
