load_state() {
  local line key value
  local -A seen=()
  migrate_tsv_to_canonical
  sync_adapter_from_canonical
  [ -f "$STATE" ] || fail 'trusted state missing; run ai-upgrader init'
  while IFS= read -r line || [ -n "$line" ]; do
    [[ "$line" == *$'\t'* ]] || fail 'malformed trusted state row'
    key="${line%%$'\t'*}"; value="${line#*$'\t'}"
    case "$key" in
      FORMAT|PROVIDER|SKILL_ID|SKILL_FILE|SKILL_SHA256|PHASE|MILESTONE_ID|MILESTONE_AXIS|MILESTONE_KIND|MILESTONE_FROM|MILESTONE_TO|BASE_SHA|HEAD_SHA|LAST_KNOWN_GOOD_SHA|MILESTONE_STATUS_VALUE|FAST_GATE|MILESTONE_GATE|FULL_CI|SMOKE_GATE|REVIEW_STATUS|REVIEW_SHA|CURRENT_BUILD|CURRENT_BUILD_SHA|CURRENT_BUILD_WAIT_SCRIPT|STOP_REQUESTED|CURRENT_BLOCKER|NEXT_ACTION|APPROVED_PLAN_HASH|AUTO_MODE|UPGRADE_GOAL|AUTO_ATTEMPTS|TARGETS_AUTH_HASH) ;;
      *) fail "unknown trusted state key: $key" ;;
    esac
    [[ ! -v seen[$key] ]] || fail "duplicate trusted state key: $key"
    seen[$key]=1
    safe_value "$value" || fail "invalid trusted state value: $key"
    printf -v "$key" '%s' "$value" # assignment, NEVER source/eval
  done < "$STATE"
  for key in FORMAT PROVIDER SKILL_ID SKILL_FILE SKILL_SHA256 PHASE MILESTONE_ID MILESTONE_AXIS MILESTONE_KIND MILESTONE_FROM MILESTONE_TO BASE_SHA HEAD_SHA LAST_KNOWN_GOOD_SHA MILESTONE_STATUS_VALUE FAST_GATE MILESTONE_GATE FULL_CI SMOKE_GATE REVIEW_STATUS REVIEW_SHA CURRENT_BUILD CURRENT_BUILD_SHA CURRENT_BUILD_WAIT_SCRIPT STOP_REQUESTED CURRENT_BLOCKER NEXT_ACTION APPROVED_PLAN_HASH; do
    [[ -v seen[$key] ]] || fail "missing trusted state key: $key"
  done
  state_defaults
  [ "$FORMAT" = 6 ] || fail 'unsupported trusted state format'
  [[ "$STOP_REQUESTED" =~ ^[01]$ ]] || fail 'invalid stop state'
  [[ "$AUTO_MODE" =~ ^[01]$ && "$AUTO_ATTEMPTS" =~ ^[0-9]+$ ]] || fail 'invalid autonomous state'
  for key in BASE_SHA HEAD_SHA LAST_KNOWN_GOOD_SHA REVIEW_SHA CURRENT_BUILD_SHA; do
    value="${!key}"
    [[ -z "$value" || "$value" =~ ^[0-9a-f]{40}$ ]] || fail "invalid SHA: $key"
  done
  verify_base_anchor
}

write_state() {
  local key
  # STOP is monotonic while an agent or gate is running. A concurrent stop
  # request cannot be lost when this long-running step writes its stale state.
  if [ "${ALLOW_CLEAR_STOP:-0}" != 1 ] && [ -f "$STATE" ]; then
    if awk -F '\t' '$1=="STOP_REQUESTED" && $2=="1" {found=1} END{exit !found}' "$STATE"; then
      STOP_REQUESTED=1
    fi
  fi
  mkdir -p "$UPGRADE_DIR" "$ARCHIVE_DIR" "$TRUST_DIR" "$HUMAN_DIR"
  if [ -n "${TARGETS:-}" ] && [ -f "$TARGETS" ]; then
    emit_targets_yml
    TARGETS_AUTH_HASH="$(hash_file "$TARGETS_YML")"
  fi
  {
    for key in FORMAT PROVIDER SKILL_ID SKILL_FILE SKILL_SHA256 PHASE MILESTONE_ID MILESTONE_AXIS MILESTONE_KIND MILESTONE_FROM MILESTONE_TO BASE_SHA HEAD_SHA LAST_KNOWN_GOOD_SHA MILESTONE_STATUS_VALUE FAST_GATE MILESTONE_GATE FULL_CI SMOKE_GATE REVIEW_STATUS REVIEW_SHA CURRENT_BUILD CURRENT_BUILD_SHA CURRENT_BUILD_WAIT_SCRIPT STOP_REQUESTED CURRENT_BLOCKER NEXT_ACTION APPROVED_PLAN_HASH AUTO_MODE UPGRADE_GOAL AUTO_ATTEMPTS TARGETS_AUTH_HASH; do
      safe_value "${!key}" || fail "cannot persist multiline state: $key"
      printf '%s\t%s\n' "$key" "${!key}"
    done
  } | atomic_write "$STATE"
  persist_canonical_yaml
}

tsv_to_md() {
  local file="$1"
  if [ ! -f "$file" ] || [ ! -s "$file" ]; then printf '_none_\n'; return 0; fi
  awk -F '\t' '
    NF==0 { next }
    NR==1     {
      printf "|"
      for (i=1;i<=NF;i++) { gsub(/\|/, " · ", $i); printf " %s |", $i }
      print ""
      printf "|"
      for (i=1;i<=NF;i++) printf " --- |"
      print ""
      next
    }
    {
      printf "|"
      for (i=1;i<=NF;i++) { gsub(/\|/, " · ", $i); printf " %s |", $i }
      print ""
    }
  ' "$file"
}


DEFAULT_UPGRADE_GOAL='Upgrade the primary language/runtime and framework along the official version matrix. Cargo dependencies (gems, npm packages, plugins) follow each matrix step and must not be catalogued. Respect operator locks and explicit targets.'

is_primary_kind() {
  case "$1" in
    language|runtime|framework|frontend_framework) return 0 ;;
    *) return 1 ;;
  esac
}

operator_has_axis() {
  local id="$1"
  [ -f "${TARGETS:-}" ] || return 1
  awk -F '\t' -v a="$id" 'NR>1 && $1==a {found=1} END{exit !found}' "$TARGETS"
}

drop_cargo_from_plan() {
  local dir="$1" keep tmp id kind current target policy paths mid axis from to depends review gate required cwd command condition url what left relation right evidence
  [ -f "$dir/axes.tsv" ] || printf '%s\n' $'id\tkind\tcurrent\ttarget\tpolicy\tsource_of_truth' > "$dir/axes.tsv"
  [ -f "$dir/milestones.tsv" ] || printf '%s\n' $'id\taxis\tkind\tfrom\tto\tdepends_on\treview_required' > "$dir/milestones.tsv"
  [ -f "$dir/gates.tsv" ] || printf '%s\n' $'milestone_id\tgate\trequired\tcwd\tcommand\tpass_condition' > "$dir/gates.tsv"
  [ -f "$dir/sources.tsv" ] || printf '%s\n' $'axis\turl\twhat' > "$dir/sources.tsv"
  [ -f "$dir/constraints.tsv" ] || printf '%s\n' $'left\trelation\tright\tevidence' > "$dir/constraints.tsv"
  keep="$dir/keep.axes"
  : > "$keep"
  while IFS=$'\t' read -r id kind current target policy paths; do
    [ "$id" != id ] || continue
    if is_primary_kind "$kind" || operator_has_axis "$id"; then
      printf '%s\n' "$id" >> "$keep"
    fi
  done < "$dir/axes.tsv"
  tmp="$dir/axes.kept"
  printf '%s\n' $'id\tkind\tcurrent\ttarget\tpolicy\tsource_of_truth' > "$tmp"
  while IFS=$'\t' read -r id kind current target policy paths; do
    [ "$id" != id ] || continue
    grep -qxF "$id" "$keep" || continue
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$kind" "$current" "$target" "$policy" "$paths" >> "$tmp"
  done < "$dir/axes.tsv"
  mv -f "$tmp" "$dir/axes.tsv"

  tmp="$dir/ms.kept"
  printf '%s\n' $'id\taxis\tkind\tfrom\tto\tdepends_on\treview_required' > "$tmp"
  while IFS=$'\t' read -r mid axis kind from to depends review; do
    [ "$mid" != id ] || continue
    grep -qxF "$axis" "$keep" || continue
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$mid" "$axis" "$kind" "$from" "$to" "$depends" "$review" >> "$tmp"
  done < "$dir/milestones.tsv"
  mv -f "$tmp" "$dir/milestones.tsv"

  tmp="$dir/ms.deps"
  printf '%s\n' $'id\taxis\tkind\tfrom\tto\tdepends_on\treview_required' > "$tmp"
  # The nested awk only reads the same immutable input as this loop.
  # shellcheck disable=SC2094
  while IFS=$'\t' read -r mid axis kind from to depends review; do
    [ "$mid" != id ] || continue
    if [ "$depends" != - ]; then
      depends="$(awk -F '\t' -v deps="$depends" '
        NR>1 {ok[$1]=1}
        END {
          n=split(deps,a,","); out=""
          for(i=1;i<=n;i++) if (a[i]!="" && ok[a[i]]) {
            if (out!="") out=out ","
            out=out a[i]
          }
          print (out=="" ? "-" : out)
        }' "$dir/milestones.tsv")"
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$mid" "$axis" "$kind" "$from" "$to" "$depends" "$review" >> "$tmp"
  done < "$dir/milestones.tsv"
  mv -f "$tmp" "$dir/milestones.tsv"

  tmp="$dir/gates.kept"
  printf '%s\n' $'milestone_id\tgate\trequired\tcwd\tcommand\tpass_condition' > "$tmp"
  while IFS=$'\t' read -r mid gate required cwd command condition; do
    [ "$mid" != milestone_id ] || continue
    awk -F '\t' -v m="$mid" 'NR>1 && $1==m {found=1} END{exit !found}' "$dir/milestones.tsv" || continue
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$mid" "$gate" "$required" "$cwd" "$command" "$condition" >> "$tmp"
  done < "$dir/gates.tsv"
  mv -f "$tmp" "$dir/gates.tsv"

  tmp="$dir/src.kept"
  printf '%s\n' $'axis\turl\twhat' > "$tmp"
  while IFS=$'\t' read -r axis url what; do
    [ "$axis" != axis ] || continue
    grep -qxF "$axis" "$keep" || continue
    printf '%s\t%s\t%s\n' "$axis" "$url" "$what" >> "$tmp"
  done < "$dir/sources.tsv"
  mv -f "$tmp" "$dir/sources.tsv"

  tmp="$dir/c.kept"
  printf '%s\n' $'left\trelation\tright\tevidence' > "$tmp"
  while IFS=$'\t' read -r left relation right evidence; do
    [ "$left" != left ] || continue
    grep -qxF "$left" "$keep" || continue
    printf '%s\t%s\t%s\t%s\n' "$left" "$relation" "$right" "$evidence" >> "$tmp"
  done < "$dir/constraints.tsv"
  mv -f "$tmp" "$dir/constraints.tsv"
}

synthesize_matrix() {
  local axes="${1:-$AXES}" ms="${2:-$MILESTONES}"
  [ -f "$axes" ] || { printf 'matrix:\n'; return 0; }
  [ -f "$ms" ] || ms=/dev/null
  awk -F '\t' -v axesfile="$axes" -v msfile="$ms" '
    function q(s) {
      gsub(/\\/, "\\\\", s)
      gsub(/"/, "\\\"", s)
      return "\"" s "\""
    }
    function major(v,   a) {
      split(v, a, /[^0-9]+/)
      return a[1]+0
    }
    function load_tables(   line, n, f, i) {
      while ((getline line < axesfile) > 0) {
        n = split(line, f, "\t")
        if (f[1]=="id" || f[1]=="") continue
        aid[++na] = f[1]
        snap[f[1]] = f[3]
        if (f[2]=="runtime" || f[2]=="language") rtm[f[1]]=1
        if (f[2]=="framework" || f[2]=="frontend_framework") fwk[f[1]]=1
      }
      close(axesfile)
      while ((getline line < msfile) > 0) {
        n = split(line, f, "\t")
        if (f[1]=="id" || f[1]=="") continue
        mid[++nm] = f[1]
        maxis[nm] = f[2]
        mkind[nm] = f[3]
        mfrom[nm] = f[4]
        mto[nm] = f[5]
        mdep[nm] = f[6]
      }
      close(msfile)
      for (i=1;i<=nm;i++) {
        folded[i]=0
        foldpair[i]=0
        if (fwk[maxis[i]] && i<nm && rtm[maxis[i+1]] && index("," mdep[i+1] ",", "," mid[i] ",")) {
          foldpair[i]=i+1
          folded[i+1]=1
        }
      }
    }
    BEGIN {
      load_tables()
      print "matrix:"
      print "  - id: baseline"
      for (i=1;i<=na;i++) printf "    %s: %s\n", aid[i], q(snap[aid[i]])
      print "    role: baseline"
      if (nm==0) exit
      lastrow=0
      for (i=1;i<=nm;i++) if (!folded[i]) lastrow=i
      for (i=1;i<=nm;i++) {
        snap[maxis[i]] = mto[i]
        if (folded[i]) continue
        printf "  - id: %s\n", mid[i]
        if (foldpair[i]) {
          pi = foldpair[i]
          raxis = maxis[pi]
          for (j=1;j<=na;j++) if (aid[j]!=raxis) printf "    %s: %s\n", aid[j], q(snap[aid[j]])
          printf "    runtime_%s: %s\n", raxis, q(mfrom[pi])
          printf "    accepted_pair_%s: %s\n", raxis, q(mto[pi])
          print "    axis: framework_then_runtime"
        } else {
          for (j=1;j<=na;j++) printf "    %s: %s\n", aid[j], q(snap[aid[j]])
          printf "    axis: %s\n", mkind[i]
        }
        if (major(mfrom[i]) != major(mto[i]) && (major(mfrom[i])+major(mto[i]))>0) print "    major_boundary: true"
        if (i==lastrow) print "    final: true"
      }
    }
  '
}

synthesize_order() {
  local axes="${1:-$AXES}" ms="${2:-$MILESTONES}"
  [ -f "$axes" ] || { printf 'STOP\n'; return 0; }
  [ -f "$ms" ] || ms=/dev/null
  awk -F '\t' -v axesfile="$axes" -v msfile="$ms" '
    function pretty(s) {
      gsub(/_/, " ", s)
      return toupper(substr(s,1,1)) substr(s,2)
    }
    function load_tables(   line, n, f, i) {
      while ((getline line < axesfile) > 0) {
        n = split(line, f, "\t")
        if (f[1]=="id" || f[1]=="") continue
        aid[++na] = f[1]
        snap[f[1]] = f[3]
        if (f[2]=="runtime" || f[2]=="language") rtm[f[1]]=1
        if (f[2]=="framework" || f[2]=="frontend_framework") fwk[f[1]]=1
      }
      close(axesfile)
      while ((getline line < msfile) > 0) {
        n = split(line, f, "\t")
        if (f[1]=="id" || f[1]=="") continue
        mid[++nm] = f[1]
        maxis[nm] = f[2]
        mto[nm] = f[5]
      }
      close(msfile)
    }
    function stack_line(   j, out) {
      out=""
      for (j=1;j<=na;j++) {
        if (out!="") out=out " + "
        out=out pretty(aid[j]) " " snap[aid[j]]
      }
      return out
    }
    function others_stay(skip,   j, out) {
      out=""
      for (j=1;j<=na;j++) {
        if (aid[j]==skip) continue
        if (out!="") out=out ", "
        out=out pretty(aid[j]) " stays " snap[aid[j]]
      }
      return out
    }
    BEGIN {
      load_tables()
      if (na==0) { print "STOP"; exit }
      print stack_line()
      for (i=1;i<=nm;i++) {
        snap[maxis[i]] = mto[i]
        if (rtm[maxis[i]] && na>1) {
          rest=others_stay(maxis[i])
          if (rest!="") printf "-> %s %s while %s\n", pretty(maxis[i]), mto[i], rest
          else printf "-> %s %s\n", pretty(maxis[i]), mto[i]
        } else {
          printf "-> %s\n", stack_line()
        }
      }
      print "-> STOP"
    }
  '
}

