ensure_git_exclude() {
  local gitdir
  [ -n "${ROOT:-}" ] || ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  gitdir="$(git -C "$ROOT" rev-parse --absolute-git-dir 2>/dev/null)/info/exclude" || return 0
  mkdir -p "$(dirname "$gitdir")"
  grep -qxF '.upgrade/' "$gitdir" 2>/dev/null || printf '.upgrade/\n' >> "$gitdir"
