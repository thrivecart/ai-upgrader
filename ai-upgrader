$(registry_packet)

INDEPENDENT WHOLE-MILESTONE REVIEW. Read-only.
Do not use Bash, git, or any tool. Shell is denied on purpose.
Active primary axis: $MILESTONE_AXIS ($MILESTONE_KIND) $MILESTONE_FROM -> $MILESTONE_TO.
Locked axis version pins MUST be checked for unintended movement. Shared lockfile/manifest churn is not a locked-axis move if those pins stay.
The complete cumulative range $BASE_SHA...$HEAD_SHA is already inlined below. Review that packet only. Do not ask for git log or git diff.
Do not modify files.
Findings must be BLOCKER/HIGH/MEDIUM/LOW with file/region, evidence, risk, correction.
If there are no material findings, output exactly MILESTONE REVIEW: PASS.
BLOCKER/HIGH/MEDIUM findings block acceptance regardless of a PASS line.
Never update state or any gate statuses.

$(review_git_evidence)"
  candidate="$(mktemp "$TRUST_DIR/.review.XXXXXXXX")"
  if [ "${1:-}" = --import ]; then
    [ "$PROVIDER" = manual ] || fail 'review import requires operator-selected manual provider'
    [ $# -eq 2 ] && [ -f "$2" ] || fail 'usage: review --import <file>'
    cp "$2" "$candidate"
  else
    [ $# -eq 0 ] || fail 'usage: review [--import <file>]'
    stream_model "$candidate" invoke_readonly "$prompt"
    if grep -qiE 'Bash is denied|Grant Bash permission|I need Bash access' "$candidate"; then
      prompt="Read-only milestone review. Do not use Bash, git, or tools. The git log and full git diff below are complete and authoritative. Do not ask for a shell. If the diff is only the intended axis change and locked axis pins did not move, output exactly:
MILESTONE REVIEW: PASS

$(review_git_evidence)"
      stream_model "$candidate" invoke_readonly "$prompt"
    fi
  fi
  [ -z "$(git status --porcelain --untracked-files=normal)" ] \
    || fail 'reviewer modified the working tree; review evidence rejected'
  if [ "$(git rev-parse HEAD)" != "$HEAD_SHA" ]; then
    refresh_head
    fail 'reviewer changed HEAD; prior gates and review evidence invalidated'
  fi
  keep_model_output "$candidate" last-review.out
  cat "$candidate" | atomic_write "$REVIEW"
  rm -f "$candidate"
  REVIEW_SHA="$HEAD_SHA"
  PHASE=REVIEWED
  if grep -viE '(^|[^[:alpha:]])(no|zero|without|none of) +(material +)?(BLOCKER|HIGH|MEDIUM)' "$REVIEW" | grep -Eiq '(^|[^[:alpha:]])(BLOCKER|HIGH|MEDIUM)([^[:alpha:]]|$)'; then
