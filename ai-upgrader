extract_block_strict() {
  local name="$1" src="$2" dest="$3" expected="$4" min_rows="$5"
  awk -v b="BEGIN_AI_UPGRADER_${name}_TSV" -v e="END_AI_UPGRADER_${name}_TSV" \
      -v header="$expected" -v minimum="$min_rows" '
    function canon(s) {
      gsub(/\r/, "", s)
      sub(/^[[:space:]]+/, "", s)
      sub(/[[:space:]]+$/, "", s)
      gsub(/^`+|`+$/, "", s)
      sub(/^[[:space:]]+/, "", s)
      sub(/[[:space:]]+$/, "", s)
      return s
    }
    function norm_header(s) {
      gsub(/\t/, " ", s)
      gsub(/  +/, " ", s)
      return s
    }
    function nfields(s,   n, a) {
      n = split(s, a, "\t")
      return n
    }
    BEGIN { hfields = nfields(header) }
    {
      raw=$0
      gsub(/\r/, "", raw)
      line=canon(raw)
      if (line ~ /^```/) next
      if (done) next
      if (line==b || index(line, b)==1) {begins++; if (begins!=1 || inside || ends) bad=1; inside=1; next}
      if (line==e || index(line, e)==1) {ends++; if (!inside || ends!=1) bad=1; inside=0; if (ends==1) done=1; next}
      if (inside) {
        rows++
        if (rows==1) {
          if (line==header || norm_header(line)==norm_header(header)) {
            if (index(raw, "\t")==0) {
              gsub(/[ \t]+/, "\t", line)
              print line
            } else print raw
          } else if (nfields(raw)>=hfields || nfields(line)>=hfields) {
            print header
            print raw
            rows++
          } else {
            bad=1
            print raw
          }
        } else print raw
      }
    }
    END {
      if (begins==1 && ends==1 && !inside && rows==0 && bad==0) {
        print header
        rows=1
      }
      if (bad || begins!=1 || ends!=1 || inside || rows<minimum) exit 1
    }
  ' "$src" > "$dest" || fail "invalid/missing/duplicate $name plan block"
}

valid_repo_path() {
  local path="$1"
