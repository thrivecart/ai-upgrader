    # of them. Empty initialization scaffolding must never become success.
    awk -F '\t' '
      NR>1 {n++; if($5!="locked") bad=1}
      END {exit !(n>0 && !bad)}
    ' "$AXES" || return 1
    awk 'NR>1 {n++} END {exit n!=0}' "$GATES" || return 1
    return 0
