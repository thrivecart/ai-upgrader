  [[ "$path" != /* && "$path" != -* ]] || return 1
  [[ "$path" != *\\* && "$path" != *'*'* && "$path" != *'?'* && "$path" != *'['* ]] || return 1
  [[ "$path" != .. && "$path" != ../* && "$path" != */.. && "$path" != */../* ]] || return 1
  [[ "$path" != '.' && "$path" != ./* ]] || return 1
  [ ! -L "$ROOT/$path" ] || return 1
  [ -n "$(git -C "$ROOT" ls-files -- "$path")" ]
}

