axis_slice() {
  local sha="$1" path="$2" axis="$3" ver="$4"
  git -C "$ROOT" show "$sha:$path" 2>/dev/null | awk -v id="$axis" '
    function emit(s) {
      gsub(/[[:space:]]+/, " ", s)
      sub(/^ /, "", s)
      sub(/ $/, "", s)
      if (s != "") print s
    }
    function extract(low, k,    s, n, frag) {
      n = 0
      s = low
      while (match(s, "\"" k "(/[^\"]*)?\"[ \t]*:[ \t]*(\"[^\"]*\"|[^, \t}\]]+)")) {
        emit(substr(s, RSTART, RLENGTH))
        n++
        s = substr(s, RSTART + RLENGTH)
      }
      s = low
      while (match(s, "(^|[ \t{])" k "[-_]?version[ \t]*:[ \t]*[^, \t#]+")) {
        frag = substr(s, RSTART, RLENGTH)
        sub(/^[ \t{]/, "", frag)
        emit(frag)
        n++
        s = substr(s, RSTART + RLENGTH)
      }
      s = low
      while (match(s, "(^|[ \t{])" k "[ \t]*:[ \t]*[^, \t}#]+")) {
        frag = substr(s, RSTART, RLENGTH)
        sub(/^[ \t{]/, "", frag)
        emit(frag)
        n++
        s = substr(s, RSTART + RLENGTH)
      }
      s = low
      while (match(s, "(^|[ \t])" k "[ \t]+[0-9][^, \t}#]*")) {
        frag = substr(s, RSTART, RLENGTH)
        sub(/^[ \t]/, "", frag)
        emit(frag)
        n++
        s = substr(s, RSTART + RLENGTH)
      }
      s = low
      while (match(s, "/" k ":[a-zA-Z0-9._-]+")) {
        emit(substr(s, RSTART, RLENGTH))
        n++
        s = substr(s, RSTART + RLENGTH)
      }
      return n
    }
    BEGIN {
      n = split(id, p, /[_-]/)
      for (i = 1; i <= n; i++) if (length(p[i]) >= 2) t[tolower(p[i])] = 1
      t[tolower(id)] = 1
    }
    {
      low = tolower($0)
      for (k in t) extract(low, k)
    }' | sort -u
}

path_used_by_axis() {
  local want="$1" id kind current target policy paths path
  while IFS=$'\t' read -r id kind current target policy paths; do
    [ "$id" != id ] || continue
    [ "$id" = "$2" ] || continue
    while IFS= read -r path; do
      [ "$path" = "$want" ] && return 0
    done < <(normalize_source_path_list "$paths")
  done < "$AXES"
  return 1
}

active_axis_paths() {
  local id kind current target policy paths
  while IFS=$'\t' read -r id kind current target policy paths; do
    [ "$id" != id ] || continue
    [ "$id" = "$MILESTONE_AXIS" ] || continue
    normalize_source_path_list "$paths"
  done < "$AXES"
}

# A bare manifest name (package.json, tsconfig.json, ...) in source_of_truth covers
# that file at any depth (monorepos); entries with '/' match exactly or as a glob.
scope_match() {
  local f="$1" p="$2"
  [ "$f" = "$p" ] && return 0
  case "$p" in *[\*\?]*) case "$f" in $p) return 0 ;; esac ;; esac
  case "$p" in */*) return 1 ;; esac
  case "$f" in node_modules/*|*/node_modules/*|vendor/*|*/vendor/*) return 1 ;; esac
  case "$f" in */"$p") return 0 ;; esac
  return 1
}

check_milestone_scope() {
  local file ok path
  [ -n "$BASE_SHA" ] && [ -n "$HEAD_SHA" ] || return 0
  [ "$HEAD_SHA" != "$BASE_SHA" ] || return 0
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    ok=0
    while IFS= read -r path; do
      scope_match "$file" "$path" && ok=1 && break
    done < <(active_axis_paths)
    [ "$ok" = 1 ] || fail "unrelated path $file changed during milestone; gate/test files cannot be rewritten to force PASS"
  done < <(git -C "$ROOT" diff --name-only "$BASE_SHA" "$HEAD_SHA")
}

verify_milestone_version() {
  local path found=0 changed=0 content
  [ -n "$MILESTONE_AXIS" ] && [ -n "$MILESTONE_TO" ] || fail 'missing milestone target version'
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    content="$(git -C "$ROOT" show "$HEAD_SHA:$path" 2>/dev/null || true)"
    printf '%s\n' "$content" | grep -F -q -- "$MILESTONE_TO" && found=1
    if [ "$MILESTONE_FROM" != "$MILESTONE_TO" ]; then
      if [ "$(axis_slice "$BASE_SHA" "$path" "$MILESTONE_AXIS" "$MILESTONE_FROM")" != "$(axis_slice "$HEAD_SHA" "$path" "$MILESTONE_AXIS" "$MILESTONE_TO")" ]; then
        changed=1
      fi
    else
      changed=1
    fi
  done < <(active_axis_paths)
  [ "$found" = 1 ] || fail "target version $MILESTONE_TO is not present in $MILESTONE_AXIS source_of_truth"
  [ "$changed" = 1 ] || fail "source_of_truth did not move $MILESTONE_AXIS $MILESTONE_FROM -> $MILESTONE_TO"
}

plan_path_hints() {
  printf 'TRACKED FILES you may cite as source_of_truth. Do not invent paths.\n'
  git -C "$ROOT" ls-files -- 'package.json' 'package-lock.json' 'npm-shrinkwrap.json' \
    'yarn.lock' 'pnpm-lock.yaml' 'bun.lock' 'Gemfile' 'Gemfile.lock' \
    'composer.json' 'composer.lock' 'go.mod' 'go.sum' 'Cargo.toml' 'Cargo.lock' \
    'pyproject.toml' 'poetry.lock' 'uv.lock' 'Pipfile' 'Pipfile.lock' 'mix.exs' 'mix.lock' \
    'Makefile' '.nvmrc' '.tool-versions' '.ruby-version' 'tsconfig.json' 'tsconfig*.json' \
    '.github/workflows/*' '*.yml' '*.yaml' 2>/dev/null | head -n 80
}

# Tracked files that still contain an upgrade axis's current version but are not in any
# axis's source_of_truth. Added to that axis so no hard-coded pin (CI, Docker, scripts, docs) is missed.
auto_version_paths() { # $1=axes.tsv $2=axis id $3=current version $4=kept (|-list)
  local axes="$1" id="$2" cur="$3" kept="$4" f p max="${AI_UPGRADER_AUTOPIN_MAX:-30}" hits=() add=() skip other
  [ "${AI_UPGRADER_NO_AUTOPIN:-0}" != 1 ] || return 0
  case "$cur" in *[0-9].[0-9]*) ;; *) return 0 ;; esac
  other="$(awk -F '\t' -v a="$id" 'NR>1 && $1!=a {print $6}' "$axes" | tr '|' '\n')"
  while IFS= read -r f; do [ -n "$f" ] && hits+=("$f"); done < <(
    git -C "$ROOT" grep -lIF -w -e "$cur" -- . ':!node_modules' ':!vendor' ':!*.lock' ':!*lock.json' \
      ':!*lock.yaml' ':!*.min.*' ':!*.map' ':!CHANGELOG*' ':!**/CHANGELOG*' ':!.upgrade' 2>/dev/null | head -n $((max + 1)))
  if [ "${#hits[@]}" -gt "$max" ]; then
    info "WARN: $id current $cur appears in more than $max files; not auto-adding (set AI_UPGRADER_AUTOPIN_MAX)." >&2
    return 0
  fi
  for f in "${hits[@]}"; do
    skip=0
    while IFS= read -r p; do [ -n "$p" ] && scope_match "$f" "$p" && { skip=1; break; }; done < <(printf '%s\n' "$kept" | tr '|' '\n')
    [ "$skip" = 0 ] || continue
    while IFS= read -r p; do [ -n "$p" ] && scope_match "$f" "$p" && { skip=1; break; }; done <<< "$other"
    [ "$skip" = 0 ] || continue
    valid_repo_path "$f" && add+=("$f")
  done
  [ "${#add[@]}" -eq 0 ] || printf '%s\n' "${add[@]}"
}

validate_plan_tables() {
  local dir="$1" axis policy paths path id kind current target mid gate required cwd command condition url what
  awk -F '\t' 'NR>1 {if(NF!=6 || $1=="" || seen[$1]++ || ($5!="locked" && $5!="upgrade") || $6=="") exit 1} END{if(NR<2) exit 1}' "$dir/axes.tsv" || fail 'invalid axis rows'
  awk -F '\t' 'NR>1 {if(NF!=4 || $1=="" || $2=="" || $3=="") exit 1}' "$dir/constraints.tsv" || fail 'invalid constraint rows'
  awk -F '\t' 'NR>1 {if(NF!=7 || $1=="" || $2=="" || $3=="" || $4=="" || $5=="" || $6=="" || $7!="true" || seen[$1]++) exit 1}' "$dir/milestones.tsv" || fail 'invalid milestones; P0 requires review=true'
  printf '%s\n' $'id\tkind\tcurrent\ttarget\tpolicy\tsource_of_truth' > "$dir/axes.clean"
  while IFS=$'\t' read -r id kind current target policy paths; do
    [ "$id" != id ] || continue
    valid_identifier "$id" || fail "invalid axis id: $id"
    if [ "$policy" = upgrade ]; then
      awk -F '\t' -v a="$id" -v t="$target" \
        'NR>1 && $1==a && ($3=="locked" || ($3=="upgrade" && $2!=t)) {bad=1} END{exit bad}' "$TARGETS" \
        || fail "plan contradicts operator target/lock: $id"
      if awk -F '\t' 'NR>1 && $3=="upgrade" {found=1} END{exit !found}' "$TARGETS"; then
        awk -F '\t' -v a="$id" -v t="$target" \
          'NR>1 && $1==a && $2==t && $3=="upgrade" {found=1} END{exit !found}' "$TARGETS" \
          || fail "unrequested upgrade axis in plan: $id"
      fi
      [[ "$target" != CURRENT && "$target" != '-' ]] || fail "missing upgrade version for axis: $id"
    fi
    local kept='' path companion
    while IFS= read -r path; do
      [ -n "$path" ] || continue
      if valid_repo_path "$path"; then
        append_source_path "$path"
        while IFS= read -r companion; do
          [ -n "$companion" ] || continue
          valid_repo_path "$companion" && append_source_path "$companion"
        done < <(companion_lockfiles "$path")
      fi
    done < <(normalize_source_path_list "$paths")
    [ -n "$kept" ] || fail "untracked/unsafe source_of_truth: $id:$paths"
    if [ "$policy" = upgrade ]; then
      local extra added=''
      while IFS= read -r extra; do
        [ -n "$extra" ] || continue
        append_source_path "$extra"
        added="$added $extra"
      done < <(auto_version_paths "$dir/axes.tsv" "$id" "$current" "$kept")
      [ -z "$added" ] || info "Auto-added to $id source_of_truth (contain $current):$added" >&2
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$kind" "$current" "$target" "$policy" "$kept" >> "$dir/axes.clean"
  done < "$dir/axes.tsv"
  mv -f "$dir/axes.clean" "$dir/axes.tsv"
  awk -F '\t' 'NR>1 {if(NF!=3 || $1=="" || $2=="" || $3=="" || seen[$1 SUBSEP $2]++) exit 1}' "$dir/sources.tsv" || fail 'invalid SOURCES rows'
  while IFS=$'\t' read -r axis url what; do
    [ "$axis" != axis ] || continue
    valid_identifier "$axis" || fail "invalid sources axis: $axis"
    [[ "$url" =~ ^https://[A-Za-z0-9] ]] || fail "sources URL must be https:// : $axis"
    awk -F '\t' -v a="$axis" 'NR>1 && $1==a {found=1} END{exit !found}' "$dir/axes.tsv" || fail "sources row for unknown axis: $axis"
  done < "$dir/sources.tsv"
  while IFS=$'\t' read -r id kind current target policy paths; do
    [ "$id" != id ] || continue
    if [ "$policy" = upgrade ] && [ "$current" = "$target" ]; then
      fail "upgrade axis has no version gap: $id"
    fi
    if [ "$policy" = locked ] && [ -f "$TARGETS" ] && \
      awk -F '\t' -v a="$id" 'NR>1 && $1==a && $3=="locked" {found=1} END{exit !found}' "$TARGETS"; then
      continue
    fi
    awk -F '\t' -v a="$id" 'NR>1 && $1==a {found=1} END{exit !found}' "$dir/sources.tsv" \
      || fail "axis has no official SOURCES https URL: $id"
    awk -F '\t' -v a="$id" 'NR>1 && $1==a && tolower($3) ~ /^opened:/ {found=1} END{exit !found}' "$dir/sources.tsv" \
      || fail "axis $id has no opened official source; model_knowledge cannot prove the current target"
  done < "$dir/axes.tsv"
  local upgrade_n=0
  upgrade_n="$(awk -F '\t' 'NR>1 && $5=="upgrade" {n++} END{print n+0}' "$dir/axes.tsv")"
  if [ "$upgrade_n" = 0 ]; then
    awk -F '\t' 'END{exit NR!=1}' "$dir/milestones.tsv" || fail 'no-upgrade plan must have empty milestones'
    awk -F '\t' 'END{exit NR!=1}' "$dir/gates.tsv" || fail 'no-upgrade plan must have empty gates'
  else
    awk -F '\t' 'END{if(NR<2)exit 1}' "$dir/milestones.tsv" || fail 'invalid milestones; P0 requires review=true'
  fi
  # No plan text can authorize targets: require every operator target/lock to match.
  while IFS=$'\t' read -r axis target policy; do
    [ "$axis" != component ] || continue
    awk -F '\t' -v a="$axis" -v p="$policy" -v t="$target" 'NR>1 && $1==a && $5==p && (t=="CURRENT" || $4==t) {found=1} END{exit !found}' "$dir/axes.tsv" || fail "operator target/lock missing or changed in plan: $axis"
  done < "$TARGETS"
  [ "$upgrade_n" != 0 ] || return 0
  while IFS=$'\t' read -r mid axis kind current target rest; do
    [ "$mid" != id ] || continue
    valid_identifier "$mid" || fail "invalid milestone id: $mid"
    awk -F '\t' -v a="$axis" 'NR>1 && $1==a && $5=="upgrade" {found=1} END{exit !found}' "$dir/axes.tsv" || fail "milestone targets a locked/unknown axis: $mid:$axis"
    [ "$current" != "$target" ] || fail "milestone has no version change: $mid"
  done < "$dir/milestones.tsv"
  # Missing milestones or cycles must never be treated as 'nothing left to do'.
  while IFS=$'\t' read -r axis kind current target policy paths; do
    [ "$axis" != id ] || continue
    [ "$policy" != upgrade ] || awk -F '\t' -v a="$axis" -v t="$target" 'NR>1 && $2==a && $5==t {found=1} END{exit !found}' "$dir/milestones.tsv" || fail "upgrade axis lacks milestone for final target: $axis"
  done < "$dir/axes.tsv"
  awk -F '\t' 'NR>1 && $6!="-" {n=split($6,a,","); for(i=1;i<=n;i++)dep[a[i]]=1} NR>1 {milestone[$1]=1} END {for(d in dep)if(!milestone[d])exit 1}' "$dir/milestones.tsv" || fail 'milestone references unknown dependency'
  awk -F '\t' '
    NR>1 {ids[$1]=1; deps[$1]=$6; n++}
    END {
      for (round=0;round<n;round++) {
        progress=0
        for (id in ids) {
          if (done[id]) continue
          count=split(deps[id],list,","); ready=1
          for (i=1;i<=count;i++) if (list[i]!="-" && !done[list[i]]) ready=0
          if (ready) {done[id]=1;progress++}
        }
        if (!progress) break
      }
      for (id in ids) if (!done[id]) exit 1
    }' "$dir/milestones.tsv" || fail 'milestone dependency cycle'
  awk -F '\t' 'NR>1 {if(NF!=6 || $1=="" || $2=="" || $3=="" || $4=="" || $5=="" || $6=="" || seen[$1 SUBSEP $2]++)exit 1} END{if(NR<5)exit 1}' "$dir/gates.tsv" || fail 'invalid gate rows'
  while IFS=$'\t' read -r mid gate required cwd command condition; do
    [ "$mid" != milestone_id ] || continue
    valid_identifier "$mid" || fail 'invalid gate milestone id'
    awk -F '\t' -v m="$mid" 'NR>1 && $1==m {found=1} END{exit !found}' "$dir/milestones.tsv" || fail "gate has unknown milestone: $mid"
    case "$gate" in fast_gate|milestone_gate|full_ci|smoke) ;; *) fail "unknown gate: $gate" ;; esac
    case "$required" in true|false) ;; *) fail "invalid required field: $gate" ;; esac
    if [ "$gate" = fast_gate ] || [ "$gate" = milestone_gate ]; then
      [ "$required" = true ] || fail "mandatory gate disabled: $gate"
    fi
    if [ "$required" = false ]; then
      [ "$cwd" = - ] && [ "$command" = - ] && [ "$condition" = - ] || fail "disabled gate contains command: $gate"
    else
      [ -n "$command" ] && [ "$command" != - ] || fail "missing command: $gate"
      safe_value "$command" || fail "multiline gate command: $gate"
      case "$condition" in exit:0|sha-success) ;; *) fail "unsupported pass condition: $gate" ;; esac
      if [ "$cwd" != '.' ]; then
        [[ "$cwd" != /* && "$cwd" != *'..'* && "$cwd" != -* ]] || fail "invalid gate cwd: $cwd"
      fi
      [ -d "$ROOT/$cwd" ] && [ "$(cd "$ROOT/$cwd" && pwd -P)" = "$ROOT" ] || {
        # Nested cwd is fine only if it remains strictly inside the root.
        [ -d "$ROOT/$cwd" ] && [[ "$(cd "$ROOT/$cwd" && pwd -P)" == "$ROOT/"* ]] || fail "gate cwd escapes worktree: $cwd"
      }
    fi
  done < "$dir/gates.tsv"
  while IFS=$'\t' read -r mid axis kind current target rest; do
    [ "$mid" != id ] || continue
    for gate in fast_gate milestone_gate full_ci smoke; do
      [ "$(awk -F '\t' -v m="$mid" -v g="$gate" 'NR>1 && $1==m && $2==g {n++} END{print n+0}' "$dir/gates.tsv")" = 1 ] || fail "missing/duplicate gate: $mid:$gate"
    done
  done < "$dir/milestones.tsv"
}

normalize_plan_tables() {
  local src="$1" dir name
  dir="$(mktemp -d "$TRUST_DIR/.plan.XXXXXXXX")"
  extract_block_strict AXES "$src" "$dir/axes.tsv" $'id\tkind\tcurrent\ttarget\tpolicy\tsource_of_truth' 2
  awk -F '\t' 'BEGIN{OFS="\t"} NR>1 && $5=="lock" {$5="locked"} {print}' "$dir/axes.tsv" > "$dir/axes.tsv.norm" && mv -f "$dir/axes.tsv.norm" "$dir/axes.tsv"
  extract_block_strict CONSTRAINTS "$src" "$dir/constraints.tsv" $'left\trelation\tright\tevidence' 1
  extract_block_strict MILESTONES "$src" "$dir/milestones.tsv" $'id\taxis\tkind\tfrom\tto\tdepends_on\treview_required' 1
  awk -F '\t' '
    FNR==NR {if (FNR>1) axis[$1]=1; next}
    FNR>1 && !axis[$2] {exit 1}
  ' "$dir/axes.tsv" "$dir/milestones.tsv" \
    || fail 'milestone targets multiple or unknown primary axes'
  # Validate references before cargo milestones are filtered. Filtering may
  # remove a valid cargo prerequisite, but must never hide a nonexistent ID.
  awk -F '\t' '
    NR>1 {milestone[$1]=1; deps[$1]=$6}
    END {
      for (id in deps) {
        n=split(deps[id], list, ",")
        for (i=1;i<=n;i++) {
          dep=list[i]
          if (dep!="" && dep!="-" && !milestone[dep]) exit 1
        }
      }
    }
  ' "$dir/milestones.tsv" || fail 'milestone references unknown dependency'
  extract_block_strict GATES "$src" "$dir/gates.tsv" $'milestone_id\tgate\trequired\tcwd\tcommand\tpass_condition' 1
  if grep -q 'BEGIN_AI_UPGRADER_SOURCES_TSV' "$src"; then
    extract_block_strict SOURCES "$src" "$dir/sources.tsv" $'axis\turl\twhat' 1
  else
    printf 'axis\turl\twhat\n' > "$dir/sources.tsv"
  fi
  drop_cargo_from_plan "$dir"
  validate_plan_tables "$dir"
  # All validation precedes publication. Existing plan remains intact on error.
  mv -f "$dir/axes.tsv" "$AXES"
  mv -f "$dir/constraints.tsv" "$CONSTRAINTS"
  mv -f "$dir/milestones.tsv" "$MILESTONES"
  mv -f "$dir/gates.tsv" "$GATES"
  mv -f "$dir/sources.tsv" "$SOURCES"
  cp "$src" "$PLAN_RAW"
  printf 'id\tstatus\n' > "$MILESTONE_STATUS"
  awk -F '\t' 'NR>1 {print $1 "\tPENDING"}' "$MILESTONES" >> "$MILESTONE_STATUS"
  persist_canonical_yaml
  rm -rf -- "$dir"
}

