cursor_isolated() {
  local mcp="$HOME/.cursor/mcp.json" bak rc=0
  if [ ! -f "$mcp" ]; then
    agent "$@"
    return $?
  fi
  bak="$(mktemp "${TMPDIR:-/tmp}/ai-upgrader-mcp.XXXXXX")"
  cp "$mcp" "$bak"
  restore_mcp() { cp "$bak" "$mcp" >/dev/null 2>&1 || true; rm -f "$bak"; }
  trap restore_mcp EXIT INT TERM
  printf '%s\n' '{"mcpServers":{}}' > "$mcp"
  agent "$@" || rc=$?
  restore_mcp
  trap - EXIT INT TERM
  return "$rc"
}

cursor_decode_stream() {
  awk -v raw="${AI_UPGRADER_CURSOR_RAW:-}" '
    function emit_texts(s,    i, c, out, esc) {
      while (match(s, /"(text|result)"[[:space:]]*:[[:space:]]*"/)) {
        s = substr(s, RSTART + RLENGTH)
        out = ""; esc = 0
        for (i = 1; i <= length(s); i++) {
          c = substr(s, i, 1)
          if (esc) {
            if (c == "n") out = out "\n"
            else if (c == "t") out = out "\t"
            else if (c == "r") out = out "\r"
            else out = out c
            esc = 0
            continue
          }
          if (c == "\\") { esc = 1; continue }
          if (c == "\"") break
          out = out c
        }
        printf "%s", out
        fflush()
        s = substr(s, i + 1)
      }
    }
    raw != "" { print >> raw; fflush(raw) }
    $0 ~ /"model_call_id"/ { next }
    $0 ~ /"type"[[:space:]]*:[[:space:]]*"assistant"/ {
      if ($0 ~ /"timestamp_ms"/) { streamed=1; emit_texts($0) }
      else if (!streamed) emit_texts($0)
      next
    }
    $0 ~ /"type"[[:space:]]*:[[:space:]]*"result"/ { if (!streamed) emit_texts($0) }
  '
}

