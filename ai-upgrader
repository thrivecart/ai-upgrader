start_watcher() {
  [ "${AI_UPGRADER_NO_WATCH:-0}" != 1 ] || return 0
  local conf bin repo pidf pid
  conf="${AI_UPGRADER_WATCH_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/ai-upgrader/watch.env}"
  bin="$(command -v ai-upgrader-watch 2>/dev/null)" || return 0
  [ -f "$conf" ] || return 0
  grep -Eq "^WEBHOOK_URL=['\"]?[^'\" ]" "$conf" && grep -Eq "^WEBHOOK_AUTH_HEADER=['\"]?[^'\" ]" "$conf" || return 0
  repo="$(git rev-parse --show-toplevel)"
  pidf="$repo/.upgrade/watch.pid"
  if [ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null; then
    info 'Watcher already running'
    return 0
  fi
  nohup "$bin" "$repo" </dev/null >>"$repo/.upgrade/watch.log" 2>&1 &
  pid=$!
  echo "$pid" >"$pidf"
  info "Watcher started (pid $pid, log .upgrade/watch.log); disable with AI_UPGRADER_NO_WATCH=1"
}

cmd_upgrade() {
  local provider=auto goal='' option lock='' gate var gate_var result=0 entry
  local -a requested_targets=() requested_locks=()
  while [ $# -gt 0 ]; do
    option="$1"; shift
    case "$option" in
      --provider) [ $# -gt 0 ] || fail 'missing --provider value'; provider="$1"; shift ;;
      --goal) [ $# -gt 0 ] || fail 'missing --goal value'; goal="$1"; shift ;;
      --target) [ $# -gt 0 ] || fail 'missing --target axis=version'; requested_targets+=("$1"); shift ;;
      --lock) [ $# -gt 0 ] || fail 'missing --lock axis'; requested_locks+=("$1"); shift ;;
      --) [ $# -eq 0 ] || { goal="$*"; set --; } ;;
      -*) fail "unknown upgrade option: $option" ;;
      *) [ -z "$goal" ] || fail 'provide one upgrade goal'; goal="$option" ;;
    esac
  done
  [ -n "$goal" ] || goal="$DEFAULT_UPGRADE_GOAL"
  safe_value "$goal" || fail 'upgrade goal must be a single line'
  ensure_git_repo
  setup_paths
  if plan_artifacts_present; then
    load_state
    if [ "$provider" != auto ]; then
      select_provider "$provider"
      write_state
    fi
    purge_agent_garbage
    info 'Using existing plan'
  else
    start_fresh_session "$provider"
    info 'No plan; planning from scratch'
  fi
  load_state
  if [ "${#requested_targets[@]}" -gt 0 ] || [ "${#requested_locks[@]}" -gt 0 ]; then
    [ "$PHASE" = DISCOVER ] && [ -z "$MILESTONE_ID" ] || fail '--target/--lock flags must be set before planning; use existing state and resume otherwise'
    for entry in "${requested_targets[@]}"; do
      [[ "$entry" == *=* ]] || fail 'target must use axis=version'
      upsert_target "${entry%%=*}" "${entry#*=}" upgrade
    done
    for entry in "${requested_locks[@]}"; do
      valid_identifier "$entry" || fail "invalid locked axis: $entry"
      if awk -F '\t' -v a="$entry" 'NR>1 && $1==a && $3=="upgrade" {n++} END{exit n<1}' "$TARGETS"; then
        fail "axis cannot be both upgraded and locked: $entry"
      fi
      upsert_target "$entry" CURRENT locked
    done
    load_state
  fi
  [ "$PROVIDER" != manual ] || fail 'autonomous upgrade requires an AI provider'
  [ "$STOP_REQUESTED" = 0 ] || fail 'stop requested; use ai-upgrader resume explicitly'
  [ "$AUTO_MODE" != 1 ] || [ "$UPGRADE_GOAL" = "$goal" ] || fail 'existing autonomous goal differs; use ai-upgrader resume'
  if [ "$AUTO_MODE" != 1 ]; then
    [ -z "$MILESTONE_ID" ] || [ "$MILESTONE_STATUS_VALUE" = ACCEPTED ] || fail 'cannot switch an active manual milestone into autonomous mode'
    AUTO_MODE=1
    UPGRADE_GOAL="$goal"
    write_state
  fi
  lock="$TRUST_DIR/upgrade.lock"
  mkdir "$lock" 2>/dev/null || fail 'another autonomous upgrade is running; inspect lock before recovery'
  AUTO_LOCK="$lock"
  trap 'rmdir -- "$AUTO_LOCK" 2>/dev/null || true' EXIT
  start_watcher
  apply_human_axes_md
  write_human_docs
  if [ "$PHASE" = BLOCKED ]; then
    PHASE=ACTIVE
    CURRENT_BLOCKER=''
    if [ -n "$BASE_SHA" ] && [ "$(git rev-parse HEAD)" = "$BASE_SHA" ]; then
      AUTO_ATTEMPTS=0
    fi
    # A stale FAIL is not current proof. Resume must re-run those gates
    # before the writer circuit breaker can fire again.
    for gate_var in FAST_GATE MILESTONE_GATE FULL_CI SMOKE_GATE; do
      if [ "${!gate_var}" = FAIL ]; then
        printf -v "$gate_var" NOT_RUN
      fi
    done
    if [ "$REVIEW_STATUS" = FAIL ]; then
      REVIEW_STATUS=NOT_RUN
      REVIEW_SHA=''
    fi
    write_state
  fi
  if plan_artifacts_present && [ -z "$MILESTONE_ID" ]; then
    PHASE=PLANNED
    write_state
  fi
  if [ "$PHASE" = DISCOVER ]; then
    info 'No validated plan; planning'
    AI_UPGRADER_NO_WIPE=1 auto_step plan plan || auto_block
  else
    info 'Existing plan kept; not replanning'
  fi
  load_state
  if [ "$PHASE" = PLANNED ]; then auto_step approve auto-approve || auto_block; fi
  local iterations=0
  while [ "$iterations" -lt 2000 ]; do
    iterations=$((iterations+1))
    load_state
    [ "$STOP_REQUESTED" = 0 ] || { info 'Stop acknowledged; no next stage started.'; return 0; }
    assert_approved
    if auto_done; then
      PHASE=COMPLETE
      NEXT_ACTION='All milestones accepted; upgrade complete.'
      CURRENT_BLOCKER=''
      write_state
      if awk -F '\t' 'NR>1 && $2=="BLOCKED" {found=1} END{exit !found}' "$MILESTONE_STATUS"; then
        info "Upgrade complete (partial): blocked edges recorded in constraints.yml; HEAD $(git rev-parse HEAD)"
      else
        info "Upgrade complete: all milestones accepted at $(git rev-parse HEAD)"
      fi
      return 0
    fi
    if [ -z "$MILESTONE_ID" ] || [ "$MILESTONE_STATUS_VALUE" = ACCEPTED ] || [ "$MILESTONE_STATUS_VALUE" = BLOCKED ]; then
      auto_step begin begin || auto_block
      continue
    fi
    finalize_writer_commit
    require_clean || { CURRENT_BLOCKER='dirty working tree prevents autonomous execution'; auto_block; }
    refresh_head
    if [ "$HEAD_SHA" = "$BASE_SHA" ] || [ "$FAST_GATE" = FAIL ] || [ "$MILESTONE_GATE" = FAIL ] || [ "$FULL_CI" = FAIL ] || [ "$SMOKE_GATE" = FAIL ] || [ "$REVIEW_STATUS" = FAIL ]; then
      if [ "$HEAD_SHA" = "$BASE_SHA" ] && writer_reported_edge_block "$TRUST_DIR/logs/last-writer.out"; then
        record_writer_edge_block "$TRUST_DIR/logs/last-writer.out" || auto_block
        load_state
        continue
      fi
      if [ "$AUTO_ATTEMPTS" -ge 3 ]; then
        CURRENT_BLOCKER="circuit breaker: three writer attempts exhausted for $MILESTONE_ID"
        auto_block
      fi
      AUTO_ATTEMPTS=$((AUTO_ATTEMPTS+1))
      NEXT_ACTION="writer attempt $AUTO_ATTEMPTS/3 for $MILESTONE_ID; resolve any recorded gate/review blocker"
      write_state
      auto_step writer run || auto_block
      load_state
      if [ "$HEAD_SHA" = "$BASE_SHA" ]; then
        [ -z "$MILESTONE_ID" ] || { CURRENT_BLOCKER='writer returned without a milestone commit'; auto_block; }
        continue
      fi
      continue
    fi
    # Missing/running gates always need execution or an explicit blocker.
    for gate in fast_gate milestone_gate full_ci smoke; do
      load_state
      [ "$STOP_REQUESTED" = 0 ] || { info 'Stop acknowledged between gates.'; return 0; }
      if ! gate_required "$gate"; then continue; fi
      var="$(gate_variable "$gate")"
      if [ "${!var}" = PASS ]; then continue; fi
      if ! auto_step "$gate" gate "$gate"; then
        load_state
        [ "${!var}" = FAIL ] || auto_block
        NEXT_ACTION="repair failed $gate using diagnostics (writer attempt $AUTO_ATTEMPTS/3)"
        write_state
        break
      fi
    done
    load_state
    if [ "$FAST_GATE" = FAIL ] || [ "$MILESTONE_GATE" = FAIL ] || [ "$FULL_CI" = FAIL ] || [ "$SMOKE_GATE" = FAIL ]; then
      continue
    fi
    [ "$FAST_GATE" = PASS ] && [ "$MILESTONE_GATE" = PASS ] || { CURRENT_BLOCKER='required gate not PASS'; auto_block; }
    if [ "$REVIEW_STATUS" != PASS ] || [ "$REVIEW_SHA" != "$HEAD_SHA" ]; then
      if ! auto_step review review; then
        load_state
        [ "$REVIEW_STATUS" = FAIL ] || auto_block
        continue
      fi
    fi
    auto_step accept accept || auto_block
  done
  CURRENT_BLOCKER='autonomous iteration limit exceeded'
  auto_block
}

cmd_resume() {
  load_state
  [ "$AUTO_MODE" = 1 ] || { cmd_run; return; }
  STOP_REQUESTED=0
  [ "$PHASE" != STOPPED ] || PHASE=BLOCKED
  ALLOW_CLEAR_STOP=1
  write_state
  unset ALLOW_CLEAR_STOP
  cmd_upgrade --goal "$UPGRADE_GOAL"
}

cmd_skill() {
  load_state
  [ -f "$SKILL_FILE" ] || fail "active skill missing: $SKILL_FILE"
  [ "$(hash_file "$SKILL_FILE")" = "$SKILL_SHA256" ] || fail 'active skill integrity mismatch'
  echo "Active skill: universal"
  echo "File: $SKILL_FILE"
  echo "SHA256: $SKILL_SHA256"
  [ "${1:-}" != cat ] || cat "$SKILL_FILE"
}

cmd_doctor() {
  ensure_git_repo
  printf 'git: '; git --version
  printf 'provider auto-detect: %s\n' "$(provider_detect)"
  printf 'gh: '; if have gh; then gh --version | head -1; else echo missing; fi
  printf 'claude: '; if have claude; then echo available; else echo missing; fi
  printf 'codex: '; if have codex; then echo available; else echo missing; fi
  printf 'cursor agent: '; if have agent; then echo available; else echo missing; fi
}

usage() {
  cat <<EOF2
AI Upgrade Engine v$VERSION

  ai-upgrader [--provider claude|codex|cursor] <command> ...

After plan:
  ai-upgrader graph
  ai-upgrader approve-plan
  ai-upgrader upgrade

Setup:
  ai-upgrader init [claude|codex|cursor|manual]
  ai-upgrader target <component> <version>
  ai-upgrader lock <component> [version]
  ai-upgrader unlock <component>
  ai-upgrader targets

Plan:
  ai-upgrader plan [--import <file>]
  ai-upgrader graph
  ai-upgrader approve-plan
  ai-upgrader auto-approve

Execute:
  ai-upgrader begin
  ai-upgrader run
  ai-upgrader gate <fast_gate|milestone_gate|full_ci|smoke>
  ai-upgrader gates
  ai-upgrader review [--import <file>]
  ai-upgrader accept
  ai-upgrader upgrade [--goal 'goal'] [--target axis=version] [--lock axis]

Control:
  ai-upgrader status
  ai-upgrader stop
  ai-upgrader resume
  ai-upgrader skill [cat]
  ai-upgrader doctor

Docs: README.md next to the binary / under ~/.local/share/ai-upgrader/
EOF2
}

# Unit tests may source deterministic validators without executing command
# dispatch. Executing this file with the variable set still runs normally.
if [ "${AI_UPGRADER_TEST_SOURCE_ONLY:-0}" = 1 ] && [ "${BASH_SOURCE[0]}" != "$0" ]; then
  return 0
fi

GLOBAL_PROVIDER=''
_upg_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --provider)
      [ $# -ge 2 ] || fail 'missing --provider value'
      GLOBAL_PROVIDER="$2"
      shift 2
      ;;
    *)
      _upg_args+=("$1")
      shift
      ;;
  esac
done
set -- "${_upg_args[@]}"

case "${1:-}" in
  -h|--help|help|'') usage; exit 0 ;;
esac

setup_paths
if [ -n "$GLOBAL_PROVIDER" ] && [ "${1:-}" != init ] && { [ -f "$STATE" ] || [ -f "$STATE_YML" ]; }; then
  load_state
  select_provider "$GLOBAL_PROVIDER"
  write_state
fi

case "${1:-}" in
  init) shift; cmd_init "${GLOBAL_PROVIDER:-${1:-auto}}" ;;
  target) shift; cmd_target "$@" ;;
  lock) shift; cmd_lock "$@" ;;
  unlock) shift; cmd_unlock "$@" ;;
  targets) cmd_targets ;;
  plan) shift; cmd_plan "$@" ;;
  approve-plan) cmd_approve_plan ;;
  graph) cmd_graph ;;
  begin) cmd_begin ;;
  run) cmd_run ;;
  upgrade)
    shift
    if [ -n "$GLOBAL_PROVIDER" ]; then
      cmd_upgrade --provider "$GLOBAL_PROVIDER" "$@"
    else
      cmd_upgrade "$@"
    fi
    ;;
  resume) cmd_resume ;;
  auto-approve) cmd_auto_approve ;;
  gate) shift; [ $# -eq 1 ] || fail 'usage: gate <gate_name>'; cmd_gate "$1" ;;
  gates) cmd_gates ;;
  review) shift; cmd_review "$@" ;;
  accept) cmd_accept ;;
  status) cmd_status ;;
  stop) cmd_stop ;;
  skill) shift; cmd_skill "${1:-}" ;;
  doctor) cmd_doctor ;;
  *) fail "unknown command: $1" ;;
esac
