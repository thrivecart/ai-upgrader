#!/usr/bin/env bash
set -euo pipefail

VERSION="1.0.0"
ROOT="$(pwd)"
UPGRADE_DIR="$ROOT/.upgrade"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SELF="$SCRIPT_DIR/$(basename "${BASH_SOURCE[0]}")"
DATA_HOME="${AI_UPGRADER_HOME:-$HOME/.local/share/ai-upgrader}"

cleanup_temp_artifacts() {
  [ -n "${TRUST_DIR:-}" ] && [ -d "$TRUST_DIR" ] || return 0
  rm -rf "$TRUST_DIR"/.candidate.* "$TRUST_DIR"/.plan.* "$TRUST_DIR"/.write.* \
    "$TRUST_DIR"/.review.* "$TRUST_DIR"/.approve.* "$TRUST_DIR"/.status.* \
    "$TRUST_DIR"/.axesmd.* "$TRUST_DIR"/.target.* "$TRUST_DIR"/.gate.* \
    "$TRUST_DIR"/.evid.* \
    "$TRUST_DIR/prompts" "$TRUST_DIR/skill.md" "$TRUST_DIR/logs/plan.live.md" 2>/dev/null || true
  if [ -f "$TRUST_DIR/logs/last-model.err" ] && [ ! -s "$TRUST_DIR/logs/last-model.err" ]; then
    rm -f "$TRUST_DIR/logs/last-model.err"
  fi
}
fail() {
  cleanup_temp_artifacts || true
  printf 'ERROR: %s\n' "${*:-unspecified failure}" >&2
  exit 1
}
info() { printf '%s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }
shell_quote() { printf '%q' "$1"; }
hash_stream() {
  if have sha256sum; then sha256sum | awk '{print $1}'
  elif have shasum; then shasum -a 256 | awk '{print $1}'
  else fail 'sha256sum or shasum is required'; fi
}
hash_file() { hash_stream < "$1"; }

# All authority is out of the repository. The writer MUST be sandboxed to its
# worktree: a process with unrestricted access as the same OS user can still
# edit the private directory. Filesystem mode 0700 is not a security sandbox.
setup_paths() {
  ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || fail 'run inside a Git repository'
  ROOT="$(cd "$ROOT" && pwd -P)"
  UPGRADE_DIR="$ROOT/.upgrade"
  ARCHIVE_DIR="$UPGRADE_DIR/archive"
  WORK_DIR="$UPGRADE_DIR/tmp"
  mkdir -p "$UPGRADE_DIR" "$ARCHIVE_DIR" "$WORK_DIR"
  # Ephemeral adapter only. Canonical truth is the YAML files below.
  # Deleting agent/ or human_readable/ must not break the CLI.
  HUMAN_DIR="$WORK_DIR"
  TRUST_DIR="$WORK_DIR"
  STATE="$WORK_DIR/state.tsv"
  TARGETS="$WORK_DIR/targets.tsv"
  AXES="$WORK_DIR/axes.tsv"
  CONSTRAINTS="$WORK_DIR/constraints.tsv"
  MILESTONES="$WORK_DIR/milestones.tsv"
  GATES="$WORK_DIR/gates.tsv"
  SOURCES="$WORK_DIR/sources.tsv"
  MILESTONE_STATUS="$WORK_DIR/milestone-status.tsv"
  PLAN="$WORK_DIR/plan.stream.md"
  PLAN_YML="$UPGRADE_DIR/plan.yml"
  MANIFEST_YML="$UPGRADE_DIR/manifest.yml"
  TARGETS_YML="$UPGRADE_DIR/targets.yml"
  RESEARCH_YML="$UPGRADE_DIR/research.yml"
  CONSTRAINTS_YML="$UPGRADE_DIR/constraints.yml"
  STATE_YML="$UPGRADE_DIR/state.yml"
  GATES_YML="$UPGRADE_DIR/gates.yml"
  REVIEW_YML="$UPGRADE_DIR/review.yml"
  PLAN_RAW="$WORK_DIR/plan.raw.md"
  REVIEW="$ARCHIVE_DIR/reviews/review.md"
  EVIDENCE_DIR="$ARCHIVE_DIR/evidence"
  mkdir -p "$ARCHIVE_DIR/reviews" "$ARCHIVE_DIR/evidence" "$ARCHIVE_DIR/logs" "$WORK_DIR/evidence" "$WORK_DIR/logs"
  migrate_legacy_state
  ensure_git_exclude
}
migrate_legacy_state() {
  local f
  mkdir -p "$UPGRADE_DIR" "$ARCHIVE_DIR" "$WORK_DIR"
  # Move historical TSV into tmp for one-shot YAML migration; do not require agent/.
  if [ ! -f "$STATE_YML" ] && [ -f "$UPGRADE_DIR/agent/state.tsv" ]; then
    for f in state.tsv targets.tsv axes.tsv constraints.tsv milestones.tsv gates.tsv sources.tsv milestone-status.tsv; do
      [ -f "$UPGRADE_DIR/agent/$f" ] && cp "$UPGRADE_DIR/agent/$f" "$WORK_DIR/$f"
    done
  fi
  if [ ! -f "$STATE_YML" ] && [ -f "$UPGRADE_DIR/state.tsv" ]; then
    for f in state.tsv targets.tsv axes.tsv constraints.tsv milestones.tsv gates.tsv milestone-status.tsv; do
      [ -f "$UPGRADE_DIR/$f" ] && cp "$UPGRADE_DIR/$f" "$WORK_DIR/$f"
    done
  fi
}
wipe_upgrade_state() {
  rm -rf "$UPGRADE_DIR"
  mkdir -p "$UPGRADE_DIR" "$ARCHIVE_DIR" "$WORK_DIR" "$ARCHIVE_DIR/reviews" "$ARCHIVE_DIR/evidence" "$ARCHIVE_DIR/logs"
  while IFS= read -r ref; do
    [ -n "$ref" ] && git update-ref -d "$ref"
  done < <(git for-each-ref --format='%(refname)' refs/ai-upgrader/ 2>/dev/null || true)
}
purge_agent_garbage() {
  mkdir -p "$WORK_DIR" "$ARCHIVE_DIR" "$ARCHIVE_DIR/reviews" "$ARCHIVE_DIR/evidence" "$ARCHIVE_DIR/logs"
  cleanup_temp_artifacts
  rm -f "$WORK_DIR/plan.live.md" "$WORK_DIR/last-model.err" 2>/dev/null || true
}
plan_artifacts_present() {
  local status phase approved
  [ -f "$PLAN_YML" ] && [ -f "$STATE_YML" ] && [ -f "$MANIFEST_YML" ] && [ -f "$GATES_YML" ] || return 1
  status="$(awk '$1=="status:" {print $2; exit}' "$PLAN_YML")"
  case "$status" in
    validated|ready|complete) return 0 ;;
    blocked)
      approved="$(awk '$1=="APPROVED_PLAN_HASH:" {gsub(/"/,""); print $2; exit}' "$STATE_YML")"
      [ -n "$approved" ] && return 0
      ;;
    draft)
      # Compatibility for plans created before the validated status existed.
      phase="$(awk '$1=="PHASE:" {gsub(/"/,""); print $2; exit}' "$STATE_YML")"
      if [ "$phase" = PLANNED ] && {
        grep -q '^  - id:' "$PLAN_YML" || grep -q '^  - id:' "$MANIFEST_YML"
      }; then
        return 0
      fi
      ;;
  esac
  return 1
}
start_fresh_session() {
  local requested_provider="${1:-auto}" key saved_targets='' saved_targets_yml='' saved_provider=''
  ensure_git_repo
  setup_paths
  if [ -f "$TARGETS_YML" ]; then
    saved_targets_yml="$(mktemp "${TMPDIR:-/tmp}/ai-upgrader-targets-yml.XXXXXX")"
    cp "$TARGETS_YML" "$saved_targets_yml"
  elif [ -f "$TARGETS" ]; then
    saved_targets="$(mktemp "${TMPDIR:-/tmp}/ai-upgrader-targets.XXXXXX")"
    cp "$TARGETS" "$saved_targets"
  fi
  if [ -f "$STATE_YML" ]; then
    saved_provider="$(awk '$1=="PROVIDER:"{gsub(/"/,""); print $2; exit}' "$STATE_YML")"
  elif [ -f "$STATE" ]; then
    saved_provider="$(awk -F '\t' '$1=="PROVIDER"{print $2; exit}' "$STATE")"
  fi
  wipe_upgrade_state
  private_init
  for key in FORMAT PROVIDER SKILL_ID SKILL_FILE SKILL_SHA256 PHASE MILESTONE_ID MILESTONE_AXIS MILESTONE_KIND MILESTONE_FROM MILESTONE_TO BASE_SHA HEAD_SHA LAST_KNOWN_GOOD_SHA MILESTONE_STATUS_VALUE FAST_GATE MILESTONE_GATE FULL_CI SMOKE_GATE REVIEW_STATUS REVIEW_SHA CURRENT_BUILD CURRENT_BUILD_SHA CURRENT_BUILD_WAIT_SCRIPT STOP_REQUESTED CURRENT_BLOCKER NEXT_ACTION APPROVED_PLAN_HASH AUTO_MODE UPGRADE_GOAL AUTO_ATTEMPTS TARGETS_AUTH_HASH; do unset "$key" || true; done
  state_defaults
  if [ -n "$requested_provider" ] && [ "$requested_provider" != auto ]; then
    select_provider "$requested_provider"
  elif [ -n "$saved_provider" ] && [ "$saved_provider" != auto ]; then
    select_provider "$saved_provider"
  else
    select_provider "$requested_provider"
  fi
  if [ -n "$saved_targets_yml" ]; then
    mv -f "$saved_targets_yml" "$TARGETS_YML"
    targets_yml_to_tsv "$TARGETS_YML" "$TARGETS"
    TARGETS_AUTH_HASH="$(hash_file "$TARGETS_YML")"
  elif [ -n "$saved_targets" ]; then
    mv -f "$saved_targets" "$TARGETS"
  fi
  install_active_skill
  ensure_tables
  snapshot_git
  HEAD_SHA="$GIT_HEAD"
  LAST_KNOWN_GOOD_SHA="$GIT_HEAD"
  PHASE="DISCOVER"
  NEXT_ACTION="run ai-upgrader plan"
  write_state
}
private_init() {
  mkdir -p "$WORK_DIR" "$WORK_DIR/evidence" "$WORK_DIR/logs" "$ARCHIVE_DIR" "$ARCHIVE_DIR/evidence" "$ARCHIVE_DIR/logs" "$ARCHIVE_DIR/reviews"
}
atomic_write() {
  local dest="$1" temp dir
  dir="${TRUST_DIR:-${UPGRADE_DIR:-/tmp}}"
  mkdir -p "$dir" "$(dirname "$dest")"
  temp="$(mktemp "$dir/.write.XXXXXXXX")"
  cat > "$temp"
  chmod 600 "$temp"
  mv -f "$temp" "$dest"
}
valid_identifier() { [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]]; }
safe_value() { [[ "$1" != *$'\t'* && "$1" != *$'\n'* && "$1" != *$'\r'* ]]; }
yaml_quote() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '"%s"' "$s"
}
yaml_reject_unsafe() {
  local f="$1"
  [ -f "$f" ] || return 0
  if grep -q $'\t' "$f"; then fail "unsafe YAML (tab): $f"; fi
  if grep -q '^[[:space:]]*!!' "$f"; then fail "unsafe YAML (tag): $f"; fi
  if grep -q '\&[A-Za-z]' "$f"; then fail "unsafe YAML (alias): $f"; fi
  if grep -q '^\s*\*' "$f"; then fail "unsafe YAML (alias): $f"; fi
  return 0
}
yaml_unquote() {
  local s="$1"
  if [[ "$s" == \"*\" ]]; then
    s="${s#\"}"
    s="${s%\"}"
    s="${s//\\\"/\"}"
    s="${s//\\\\/\\}"
  fi
  printf '%s' "$s"
}

emit_targets_yml() {
  local id target policy
  mkdir -p "$UPGRADE_DIR" "$ARCHIVE_DIR"
  {
    printf '%s\n' 'schema_version: 1'
    printf '%s\n' 'authorization: user_cli'
    printf '%s\n' 'targets:'
    if [ -f "$TARGETS" ]; then
      while IFS=$'\t' read -r id target policy; do
        [ "$id" != component ] || continue
        [ -n "$id" ] || continue
        printf '  %s:\n' "$id"
        printf '    target: %s\n' "$(yaml_quote "$target")"
        printf '    policy: %s\n' "$policy"
      done < "$TARGETS"
    fi
  } | atomic_write "$TARGETS_YML"
}

emit_manifest_yml() {
  local sha status id kind current target policy paths path
  sha="${LAST_KNOWN_GOOD_SHA:-${HEAD_SHA:-}}"
  [ -n "$sha" ] || sha="$(git rev-parse HEAD 2>/dev/null || true)"
  status=draft
  [ -n "${APPROVED_PLAN_HASH:-}" ] && status=ready
  [ "${PHASE:-}" = BLOCKED ] && status=blocked
  [ "${PHASE:-}" = COMPLETE ] && status=complete
  {
    printf '%s\n' 'schema_version: 1'
    printf 'status: %s\n' "$status"
    printf '%s\n' 'project:'
    printf '%s\n' '  repository: auto-discovered'
    printf '  baseline_sha: %s\n' "$(yaml_quote "$sha")"
    printf '%s\n' 'axes:'
    if [ -f "$AXES" ]; then
      while IFS=$'\t' read -r id kind current target policy paths; do
        [ "$id" != id ] || continue
        [ -n "$id" ] || continue
        printf '  - id: %s\n' "$id"
        printf '    kind: %s\n' "$kind"
        printf '    current: %s\n' "$(yaml_quote "$current")"
        printf '    target: %s\n' "$(yaml_quote "$target")"
        if [ "$policy" = upgrade ] && awk -F '\t' -v a="$id" 'NR>1 && $1==a && $3=="upgrade" {found=1} END{exit !found}' "$TARGETS" 2>/dev/null; then
          printf '%s\n' '    policy: targeted'
        else
          printf '    policy: %s\n' "$policy"
        fi
        printf '%s\n' '    source_of_truth:'
        while IFS= read -r path; do
          [ -n "$path" ] || continue
          printf '      - %s\n' "$path"
        done < <(printf '%s\n' "$paths" | tr '|' '\n')
      done < "$AXES"
    fi
  } | atomic_write "$MANIFEST_YML"
}

emit_research_yml() {
  local axis url what n=0
  {
    printf '%s\n' 'schema_version: 1'
    if [ -f "$SOURCES" ] && awk -F '\t' 'NR>1{found=1} END{exit !found}' "$SOURCES"; then
      printf '%s\n' 'status: verified'
    else
      printf '%s\n' 'status: pending_verification'
    fi
    printf '%s\n' 'official_sources:'
    if [ -f "$SOURCES" ]; then
      while IFS=$'\t' read -r axis url what; do
        [ "$axis" != axis ] || continue
        [ -n "$axis" ] || continue
        printf '  - axis: %s\n' "$axis"
        printf '    url: %s\n' "$(yaml_quote "$url")"
        printf '    what: %s\n' "$(yaml_quote "$what")"
        n=$((n+1))
      done < "$SOURCES"
    fi
    [ "$n" -gt 0 ] || printf '%s\n' '  []'
    printf '%s\n' 'unresolved_questions: []'
  } | atomic_write "$RESEARCH_YML"
}

emit_constraints_yml() {
  local left relation right evidence n=0 cid
  {
    printf '%s\n' 'schema_version: 1'
    printf '%s\n' 'constraints:'
    if [ -f "$CONSTRAINTS" ]; then
      while IFS=$'\t' read -r left relation right evidence; do
        [ "$left" != left ] || continue
        [ -n "$left" ] || continue
        cid="$(printf '%s-%s-%s' "$left" "$relation" "$right" | tr ' /:@' '----')"
        printf '  - id: %s\n' "$cid"
        printf '%s\n' '    type: compatibility'
        printf '    source_axis: %s\n' "$left"
        printf '    target_axis: %s\n' "$right"
        printf '    requirement: %s\n' "$(yaml_quote "$relation")"
        printf '    evidence: %s\n' "$(yaml_quote "$evidence")"
        n=$((n+1))
      done < "$CONSTRAINTS"
    fi
    [ "$n" -gt 0 ] || printf '%s\n' '  []'
  } | atomic_write "$CONSTRAINTS_YML"
}

emit_plan_yml() {
  local status mid axis kind from to depends review gid gname req cwd path n
  status=draft
  [ "${PHASE:-}" = PLANNED ] && status=validated
  [ -n "${APPROVED_PLAN_HASH:-}" ] && status=ready
  [ "${PHASE:-}" = BLOCKED ] && status=blocked
  [ "${PHASE:-}" = COMPLETE ] && status=complete
  {
    printf '%s\n' 'schema_version: 1'
    printf 'status: %s\n' "$status"
    printf '%s\n' 'execution:'
    printf '%s\n' '  initial_phase: plan_only'
    printf '%s\n' '  require_explicit_run: true'
    printf '%s\n' 'milestones:'
    n=0
    if [ -f "$MILESTONES" ]; then
      while IFS=$'\t' read -r mid axis kind from to depends review; do
        [ "$mid" != id ] || continue
        [ -n "$mid" ] || continue
        n=$((n+1))
        printf '  - id: %s\n' "$mid"
        printf '    axis: %s\n' "$axis"
        printf '    kind: %s\n' "$kind"
        printf '    from: %s\n' "$(yaml_quote "$from")"
        printf '    to: %s\n' "$(yaml_quote "$to")"
        if [ "$depends" = - ] || [ -z "$depends" ]; then
          printf '%s\n' '    depends_on: []'
        else
          printf '%s\n' '    depends_on:'
          printf '%s\n' "$depends" | tr ',' '\n' | while IFS= read -r gid; do
            [ -n "$gid" ] || continue
            printf '      - %s\n' "$gid"
          done
        fi
        printf '%s\n' '    locked_axes:'
        awk -F '\t' -v cur="$axis" 'NR>1 && $1!=cur {printf "      - %s\n", $1}' "$AXES"
        printf '%s\n' '    gates:'
        if [ -f "$GATES" ]; then
          while IFS=$'\t' read -r gid gname req cwd _cmd _cond; do
            [ "$gid" != milestone_id ] || continue
            [ "$gid" = "$mid" ] || continue
            [ "$req" = true ] || continue
            case "$gname" in
              fast_gate) printf '%s\n' '      - fast' ;;
              milestone_gate) printf '%s\n' '      - milestone' ;;
              full_ci) printf '%s\n' '      - full_ci' ;;
              smoke) printf '%s\n' '      - smoke' ;;
            esac
          done < "$GATES"
        fi
        printf '    review_required: %s\n' "$review"
        ms="PENDING"
        if [ -f "$MILESTONE_STATUS" ]; then
          ms="$(awk -F '\t' -v id="$mid" 'NR>1 && $1==id {print $2; exit}' "$MILESTONE_STATUS")"
          [ -n "$ms" ] || ms=PENDING
        fi
        printf '    status: %s\n' "$ms"
      done < "$MILESTONES"
    fi
    [ "$n" -gt 0 ] || printf '%s\n' '  []'
  } | atomic_write "$PLAN_YML"
}

lookup_gate_evidence_file() {
  local mid="$1" gate="$2"
  if [ -n "${EVIDENCE_DIR:-}" ] && [ -f "$EVIDENCE_DIR/$mid.$gate.tsv" ]; then
    printf '%s' "$EVIDENCE_DIR/$mid.$gate.tsv"
  elif [ -f "$WORK_DIR/evidence/$mid.$gate.tsv" ]; then
    printf '%s' "$WORK_DIR/evidence/$mid.$gate.tsv"
  fi
}

emit_gates_yml() {
  local mid gate required cwd command condition result sha log logh approval spec exitc ev n=0
  {
    printf '%s\n' 'schema_version: 1'
    printf '%s\n' 'gates:'
    if [ -f "$GATES" ]; then
      while IFS=$'\t' read -r mid gate required cwd command condition; do
        [ "$mid" != milestone_id ] || continue
        [ -n "$mid" ] || continue
        n=$((n+1))
        result='NOT_RUN'
        sha=''; log=''; logh=''; approval=''; spec=''; exitc=''
        ev="$(lookup_gate_evidence_file "$mid" "$gate")"
        if [ -n "$ev" ]; then
          IFS=$'\t' read -r sha approval spec exitc result logh < "$ev" || true
          [ -n "$sha" ] && log="archive/logs/$mid.$gate.$sha.log"
        fi
        printf '  - milestone_id: %s\n' "$mid"
        printf '    gate: %s\n' "$gate"
        printf '    required: %s\n' "$required"
        printf '    cwd: %s\n' "$(yaml_quote "$cwd")"
        printf '    command: %s\n' "$(yaml_quote "$command")"
        printf '    pass_condition: %s\n' "$(yaml_quote "$condition")"
        printf '    result: %s\n' "$result"
        printf '    sha: %s\n' "$(yaml_quote "$sha")"
        printf '    log: %s\n' "$(yaml_quote "$log")"
        printf '    log_hash: %s\n' "$(yaml_quote "$logh")"
        printf '    approval: %s\n' "$(yaml_quote "$approval")"
        printf '    spec_hash: %s\n' "$(yaml_quote "$spec")"
        printf '    exitcode: %s\n' "$(yaml_quote "$exitc")"
      done < "$GATES"
    fi
    [ "${n:-0}" -gt 0 ] || printf '%s\n' '  []'
  } | atomic_write "$GATES_YML"
}

emit_state_yml() {
  local key
  {
    printf '%s\n' 'schema_version: 1'
    printf '%s\n' 'state:'
    if [ -f "$STATE" ]; then
      while IFS=$'\t' read -r key value; do
        [ -n "$key" ] || continue
        printf '  %s: %s\n' "$key" "$(yaml_quote "$value")"
      done < "$STATE"
    else
      for key in FORMAT PROVIDER SKILL_ID SKILL_FILE SKILL_SHA256 PHASE MILESTONE_ID MILESTONE_AXIS MILESTONE_KIND MILESTONE_FROM MILESTONE_TO BASE_SHA HEAD_SHA LAST_KNOWN_GOOD_SHA MILESTONE_STATUS_VALUE FAST_GATE MILESTONE_GATE FULL_CI SMOKE_GATE REVIEW_STATUS REVIEW_SHA CURRENT_BUILD CURRENT_BUILD_SHA CURRENT_BUILD_WAIT_SCRIPT STOP_REQUESTED CURRENT_BLOCKER NEXT_ACTION APPROVED_PLAN_HASH AUTO_MODE UPGRADE_GOAL AUTO_ATTEMPTS TARGETS_AUTH_HASH; do
        printf '  %s: %s\n' "$key" "$(yaml_quote "${!key:-}")"
      done
    fi
  } | atomic_write "$STATE_YML"
}

emit_review_yml() {
  local report="archive/reviews/review.md"
  {
    printf '%s\n' 'schema_version: 1'
    printf 'status: %s\n' "${REVIEW_STATUS:-NOT_RUN}"
    printf 'sha: %s\n' "$(yaml_quote "${REVIEW_SHA:-}")"
    printf 'report: %s\n' "$(yaml_quote "$report")"
  } | atomic_write "$REVIEW_YML"
}

persist_canonical_yaml() {
  mkdir -p "$UPGRADE_DIR" "$ARCHIVE_DIR" "$HUMAN_DIR" "$TRUST_DIR"
  [ -n "${TARGETS:-}" ] || return 0
  emit_targets_yml
  if [ -z "${TARGETS_AUTH_HASH:-}" ] && [ -f "$TARGETS_YML" ]; then
    TARGETS_AUTH_HASH="$(hash_file "$TARGETS_YML")"
  fi
  emit_manifest_yml
  emit_research_yml
  emit_constraints_yml
  emit_plan_yml
  emit_gates_yml
  emit_state_yml
  emit_review_yml
  yaml_reject_unsafe "$TARGETS_YML"
  yaml_reject_unsafe "$PLAN_YML"
  yaml_reject_unsafe "$MANIFEST_YML"
}

targets_yml_to_tsv() {
  local f="$1" dest="$2"
  yaml_reject_unsafe "$f"
  awk '
    function yv(   v) {
      v=$0
      sub(/^[[:space:]]*[^:]+:[[:space:]]*/, "", v)
      if (v ~ /^"/) { sub(/^"/, "", v); sub(/"$/, "", v); gsub(/\\"/, "\"", v) }
      return v
    }
    BEGIN { print "component\ttarget\tpolicy" }
    /^[[:space:]]*!!/ { exit 2 }
    /^[a-zA-Z0-9_]+:/ && $1!="schema_version:" && $1!="authorization:" && $1!="targets:" { if ($1 !~ /^targets:/) bad=1 }
    /^targets:/ { t=1; next }
    t && /^  [A-Za-z0-9_.-]+:[[:space:]]*$/ {
      if (id!="" && tgt!="" && pol!="") print id "\t" tgt "\t" pol
      id=$1; sub(/:$/,"",id); tgt=""; pol=""; next
    }
    t && /^    target:/ { tgt=yv(); next }
    t && /^    policy:/ { pol=yv(); next }
    END {
      if (id!="" && tgt!="" && pol!="") print id "\t" tgt "\t" pol
    }
  ' "$f" > "$dest"
}

state_yml_to_tsv() {
  local f="$1" dest="$2"
  yaml_reject_unsafe "$f"
  awk '
    /^state:/ { s=1; next }
    s && /^  [A-Z0-9_]+:/ {
      key=$1; sub(/:$/,"",key)
      val=$0
      sub(/^[[:space:]]*[A-Z0-9_]+:[[:space:]]*/, "", val)
      gsub(/^"/, "", val)
      gsub(/"$/, "", val)
      gsub(/\\"/, "\"", val)
      print key "\t" val
    }
  ' "$f" > "$dest"
}

manifest_yml_to_axes_tsv() {
  local f="$1" dest="$2"
  yaml_reject_unsafe "$f"
  awk '
    function yv(   v) {
      v=$0
      sub(/^[[:space:]]*[^:]+:[[:space:]]*/, "", v)
      if (v ~ /^"/) { sub(/^"/, "", v); sub(/"$/, "", v); gsub(/\\"/, "\"", v) }
      return v
    }
    BEGIN { print "id\tkind\tcurrent\ttarget\tpolicy\tsource_of_truth" }
    /^axes:/ { a=1; next }
    a && /^  - id:/ { flush(); id=$3; kind=cur=tgt=pol=paths=""; next }
    a && /^    kind:/ { kind=yv(); next }
    a && /^    current:/ { cur=yv(); next }
    a && /^    target:/ { tgt=yv(); next }
    a && /^    policy:/ {
      pol=yv()
      if (pol=="targeted") pol="upgrade"
      next
    }
    a && /^      - / { p=$2; if (paths!="") paths=paths "|" p; else paths=p; next }
    END { flush() }
    function flush() {
      if (id!="") print id "\t" kind "\t" cur "\t" tgt "\t" pol "\t" paths
    }
  ' "$f" > "$dest"
}

plan_yml_to_milestones_tsv() {
  local f="$1" dest="$2"
  yaml_reject_unsafe "$f"
  awk '
    function yv(   v) {
      v=$0
      sub(/^[[:space:]]*[^:]+:[[:space:]]*/, "", v)
      if (v ~ /^"/) { sub(/^"/, "", v); sub(/"$/, "", v); gsub(/\\"/, "\"", v) }
      return v
    }
    BEGIN { print "id\taxis\tkind\tfrom\tto\tdepends_on\treview_required" }
    /^milestones:/ { m=1; next }
    m && /^  - id:/ { flush(); id=$3; axis=kind=from=to=deps=rev=""; depfirst=1; next }
    m && /^    axis:/ { axis=yv(); next }
    m && /^    kind:/ { kind=yv(); next }
    m && /^    from:/ { from=yv(); next }
    m && /^    to:/ { to=yv(); next }
    m && /^    depends_on: \[\]/ { deps="-"; indep=0; next }
    m && /^    depends_on:/ { deps=""; indep=1; next }
    m && /^    locked_axes:/ { indep=0; next }
    m && /^    gates:/ { indep=0; next }
    m && indep && /^      - / {
      d=$2
      if (deps=="" || deps=="-") deps=d
      else deps=deps "," d
      next
    }
    m && /^    review_required:/ { rev=$2; next }
    m && /^    status:/ { next }
    END { flush() }
    function flush() {
      if (id=="") return
      if (deps=="") deps="-"
      if (rev=="") rev="true"
      if (kind=="") kind="runtime"
      print id "\t" axis "\t" kind "\t" from "\t" to "\t" deps "\t" rev
    }
  ' "$f" > "$dest"
}

plan_yml_to_status_tsv() {
