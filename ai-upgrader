auto_step() {
  local label="$1" logfile rc=0 pid elapsed=0
  shift
  logfile="$TRUST_DIR/logs/auto.$label.log"
  render_progress line
  info "[upgrade] $label"
  case "$label" in
    plan|writer|review)
      set +e
      AI_UPGRADER_STEP="$label" "$SELF" "$@" > "$logfile" 2>&1 &
      pid=$!
      wait "$pid"
      rc=$?
      set -e
      ;;
    *)
      info "  this can take a while"
      set +e
      AI_UPGRADER_STEP="$label" "$SELF" "$@" > "$logfile" 2>&1 &
      pid=$!
      while kill -0 "$pid" 2>/dev/null; do
        [ "${AI_UPGRADER_FAST_WAIT:-0}" = 1 ] && break
        sleep 1
        elapsed=$((elapsed+1))
        if [ $((elapsed % 15)) -eq 0 ] && kill -0 "$pid" 2>/dev/null; then
          if status_due "$elapsed"; then status_beat "$elapsed" info; else info "  still running (${elapsed}s)"; fi
        fi
      done
      wait "$pid"
      rc=$?
      set -e
      ;;
  esac
  if [ "$rc" -ne 0 ]; then
    grep -E '^ERROR:|^BLOCKED' "$logfile" | tail -5 >&2 || tail -3 "$logfile" >&2
    auto_error "$label" "$logfile"
    return "$rc"
  fi
  case "$label" in
    plan)
      info "Plan ready"
      [ -f "$AXES" ] && { info "Axes:"; cat "$AXES"; }
      [ -f "$MILESTONES" ] && { info "Milestones:"; cat "$MILESTONES"; }
      [ -f "$GATES" ] && { info "Gates:"; cat "$GATES"; }
      ;;
    writer)
      load_state
      info "Writer done HEAD=$HEAD_SHA"
      ;;
    review)
      load_state
      info "Review $REVIEW_STATUS"
      ;;
    *)
      tail -n 1 "$logfile"
      ;;
  esac
}

