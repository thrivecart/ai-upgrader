}
status_due() { [ $(( $1 % ${AI_UPGRADER_STATUS_SEC:-600} )) -eq 0 ]; }

tty_line() {
  if ! { printf '%s\n' "$1" >/dev/tty; } 2>/dev/null; then info "$1"; fi
}
stream_model() {
  local dest="$1" err pid elapsed=0 rc=0 limit
  shift
  limit="${AI_UPGRADER_MODEL_TIMEOUT:-0}"
  mkdir -p "$TRUST_DIR/logs" "$UPGRADE_DIR"
  err="$TRUST_DIR/logs/last-model.err"
  : > "$dest"
  if [ -n "${STREAM_HUMAN:-}" ]; then
    mkdir -p "$(dirname "$STREAM_HUMAN")"
    : > "$STREAM_HUMAN"
  fi
  tty_line '  streaming model output'
  set +e
  "$@" 2>> "$err" | awk -v dest="$dest" -v human="${STREAM_HUMAN:-}" '
    {
      printf "%s\n", $0 >> dest
      fflush(dest)
      if (human != "") {
        printf "%s\n", $0 >> human
        fflush(human)
      }
    }
  ' &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    [ "${AI_UPGRADER_FAST_WAIT:-0}" = 1 ] && break
    if [ "${AI_UPGRADER_STOP_WHEN_TSV:-0}" = 1 ] && plan_tsv_complete "$dest"; then
      tty_line "  plan payload ready (${elapsed}s)"
      kill "$pid" 2>/dev/null || true
      pkill -P "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      set -e
      return 0
    fi
    if [ "$limit" -gt 0 ] && [ "$elapsed" -ge "$limit" ]; then
      if [ "${AI_UPGRADER_STOP_WHEN_TSV:-0}" = 1 ] && plan_tsv_complete "$dest"; then
        tty_line "  plan payload ready (${elapsed}s)"
        kill "$pid" 2>/dev/null || true
        pkill -P "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
        set -e
        return 0
      fi
      tty_line "  timed out (${elapsed}s)"
      kill "$pid" 2>/dev/null || true
      pkill -P "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      set -e
      return 124
    fi
    sleep 1
    elapsed=$((elapsed+1))
    if [ $((elapsed % 15)) -eq 0 ] && kill -0 "$pid" 2>/dev/null; then
      if status_due "$elapsed"; then status_beat "$elapsed" tty_line; else tty_line "  still running (${elapsed}s)"; fi
    fi
  done
  wait "$pid"
  rc=$?
  set -e
  if [ "$rc" -ne 0 ] && [ "${AI_UPGRADER_STOP_WHEN_TSV:-0}" = 1 ] && plan_tsv_complete "$dest"; then
    return 0
  fi
  return "$rc"
}

