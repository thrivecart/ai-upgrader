    [ "$required" != true ] || auto_gate_command_safe "$command" || fail "unsafe/unrecognized autonomous gate: $mid/$gate; explicit operator approval required"
    [ "$required" != true ] || [ "$condition" = exit:0 ] || fail "remote CI gate requires explicit operator approval: $mid/$gate"
  done < "$GATES"
  cmd_approve_plan
  info 'Autonomous plan approved by the upgrade command under restricted gate policy.'
}

auto_done() {
