sync_adapter_from_canonical() {
  local tmp hash stored
  mkdir -p "$TRUST_DIR" "$HUMAN_DIR" "$ARCHIVE_DIR"
  if [ -f "$STATE_YML" ]; then
    state_yml_to_tsv "$STATE_YML" "$STATE"
  fi
  if [ -f "$TARGETS_YML" ]; then
    tmp="$(mktemp "$TRUST_DIR/.target.XXXXXXXX")"
    targets_yml_to_tsv "$TARGETS_YML" "$tmp"
    hash="$(hash_file "$TARGETS_YML")"
    stored=""
    if [ -f "$STATE_YML" ]; then
      stored="$(awk '$1=="TARGETS_AUTH_HASH:"{gsub(/"/,""); print $2; exit}' "$STATE_YML")"
    fi
    if [ -n "$stored" ] && [ "$stored" != "$hash" ]; then
      rm -f "$tmp"
      fail 'targets.yml was modified outside ai-upgrader target/lock/unlock'
    fi
    mv -f "$tmp" "$TARGETS"
  fi
  if [ -f "$MANIFEST_YML" ]; then manifest_yml_to_axes_tsv "$MANIFEST_YML" "$AXES"; fi
  if [ -f "$PLAN_YML" ]; then
    plan_yml_to_milestones_tsv "$PLAN_YML" "$MILESTONES"
    plan_yml_to_status_tsv "$PLAN_YML" "$MILESTONE_STATUS"
  fi
  if [ -f "$GATES_YML" ]; then gates_yml_to_tsv "$GATES_YML" "$GATES"; fi
  if [ -f "$RESEARCH_YML" ]; then research_yml_to_sources_tsv "$RESEARCH_YML" "$SOURCES"; fi
  if [ -f "$CONSTRAINTS_YML" ]; then constraints_yml_to_tsv "$CONSTRAINTS_YML" "$CONSTRAINTS"; fi
  sync_gate_evidence_from_yml
}

migrate_tsv_to_canonical() {
  local hash tmp
  mkdir -p "$UPGRADE_DIR" "$ARCHIVE_DIR"
  if [ -f "$STATE" ] && [ ! -f "$STATE_YML" ]; then
    persist_canonical_yaml
    if [ -f "$TARGETS_YML" ]; then
      hash="$(hash_file "$TARGETS_YML")"
      tmp="$(mktemp "$TRUST_DIR/.write.XXXXXXXX")"
      awk -F '\t' '$1!="TARGETS_AUTH_HASH"' "$STATE" > "$tmp"
      printf 'TARGETS_AUTH_HASH\t%s\n' "$hash" >> "$tmp"
      mv -f "$tmp" "$STATE"
      emit_state_yml
    fi
  fi
}

