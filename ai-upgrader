    FNR==NR { if (FNR>1) st[$1]=$2; next }
    FNR>1 { n++; id[n]=$1; ax[n]=$2; fr[n]=$4; to[n]=$5; if (st[$1]=="ACCEPTED") d++ }
    END {
      if (!n) exit
      f=int(20*d/n); bar=""
      for (i=1;i<=20;i++) bar=bar (i<=f ? "█" : "░")
      printf "Progress [%s] %d/%d milestones (%d%%)\n", bar, d, n, int(100*d/n)
      if (mode!="full") exit
      for (i=1;i<=n;i++) {
        s=st[id[i]]
        m=(s=="ACCEPTED") ? "✓" : (s=="BLOCKED") ? "✗" : (id[i]==cur) ? "▶" : "·"
        printf "  %s %s  %s %s -> %s  [%s]\n", m, id[i], ax[i], fr[i], to[i], (s=="" ? "PENDING" : s)
      }
    }' "$MILESTONE_STATUS" "$MILESTONES"
}

