  info "AI Upgrade Engine v$VERSION initialized"
  info "Provider: $PROVIDER"
  info "Canonical YAML: $UPGRADE_DIR"
  info "Next: ai-upgrader target <component> <version> and/or ai-upgrader lock <component> [version], then ai-upgrader plan"
}

