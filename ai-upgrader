# Autonomous mode is an explicit operator request to execute a broad upgrade.
# It is NOT permission for arbitrary model-generated shell code: only simple,
# recognized test/build commands (without a shell) may be auto-approved.
auto_gate_command_safe() {
  local command="$1" part rest stripped
  [ -n "$command" ] && [ "${#command}" -le 512 ] || return 1
  if [[ "$command" == *'&&'* ]]; then
    [[ "$command" != *'|'* && "$command" != *';'* && "$command" != *'`'* && "$command" != *'$'* && "$command" != *'||'* && "$command" != *'>'* && "$command" != *'<'* ]] || return 1
    stripped="${command//&&/}"
    [[ "$stripped" != *'&'* ]] || return 1
    rest="$command"
    while [ -n "$rest" ]; do
      if [[ "$rest" == *' && '* ]]; then
        part="${rest%% && *}"
        rest="${rest#* && }"
      else
        part="$rest"
        rest=""
      fi
      auto_gate_command_atom "$part" || return 1
    done
    return 0
  fi
  auto_gate_command_atom "$command"
}

auto_gate_command_atom() {
  local command="$1" first second third
  [ -n "$command" ] && [ "${#command}" -le 512 ] || return 1
  [[ "$command" =~ ^[a-zA-Z0-9_./:@=,+%\ -]+$ ]] || return 1
  [[ "$command" != *'..'* && "$command" != /* && "$command" != *'  '* ]] || return 1
  local -a words=()
  read -r -a words <<< "$command"
  [ "${#words[@]}" -gt 0 ] || return 1
  first="${words[0]}"
  second="${words[1]:-}"
  third="${words[2]:-}"
  case "$first" in
    bundle)
      [ "$second" = exec ] || return 1
      case "$third" in rake|rspec|rubocop|brakeman|rails|bin/rails|bin/rake|bin/rspec) ;; *) return 1 ;; esac ;;
    make)
      [ "${#words[@]}" -eq 2 ] || return 1
      case "$second" in *test*|*spec*|*fast*|*milestone*|*check*|*lint*|*build*|*smoke*|*verify*|*e2e*) ;; *) return 1 ;; esac ;;
    npm|pnpm|yarn)
      case "$second" in test|lint|build|check|typecheck|ci|install) ;;
        run) case "$third" in *test*|*spec*|*check*|*lint*|*build*|*smoke*|*e2e*) ;; *) return 1 ;; esac ;;
        *) return 1 ;; esac ;;
    npx)
      case "$second" in playwright|vitest|jest|eslint|tsc|mocha) ;; *) return 1 ;; esac ;;
    composer)
      case "$second" in test|validate|check|phpunit|phpstan) ;; *) return 1 ;; esac ;;
    php)
      [ "$second" = artisan ] && [ "$third" = test ] || return 1 ;;
    go) case "$second" in test|vet|build) ;; *) return 1 ;; esac ;;
    cargo) case "$second" in test|check|build|clippy) ;; *) return 1 ;; esac ;;
    gradle|./gradlew|mvn|./mvnw)
      case "$second" in test|check|build|verify|clean) ;; *) return 1 ;; esac ;;
    dotnet) case "$second" in test|build) ;; *) return 1 ;; esac ;;
    mix) [ "$second" = test ] || return 1 ;;
    bin/rails|./bin/rails) case "$second" in test|test:system|zeitwerk:check) ;; *) return 1 ;; esac ;;
    rake|bin/rake|./bin/rake) case "$second" in test|spec|test:all|spec:all|zeitwerk:check) ;; *) return 1 ;; esac ;;
    rspec|bin/rspec|./bin/rspec|pytest|tox|vendor/bin/phpunit|vendor/bin/pest) ;;
    *) return 1 ;;
  esac
  return 0
}

cmd_auto_approve() {
  load_state
