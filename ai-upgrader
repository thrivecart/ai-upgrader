    REVIEW_STATUS="PASS"
    NEXT_ACTION="operator: ai-upgrader accept (rechecks exact-SHA evidence and locked axes)"
  else
    REVIEW_STATUS="NEEDS_DISPOSITION"
    NEXT_ACTION="review missing unambiguous PASS; cannot accept"
  fi
  write_state
  info "Review: $REVIEW_STATUS for $REVIEW_SHA ($REVIEW)"
  [ "$REVIEW_STATUS" = PASS ] || fail 'review did not pass'
}

