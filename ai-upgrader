sync_gate_evidence_from_yml() {
  local f="$GATES_YML" tmpdir dest base
  [ -f "$f" ] || return 0
  mkdir -p "$ARCHIVE_DIR/evidence" "$WORK_DIR/evidence"
  tmpdir="$(mktemp -d "$TRUST_DIR/.evid.XXXXXXXX")"
  awk -v evid="$tmpdir" '
    function yv(   v) {
      v=$0
      sub(/^[[:space:]]*[^:]+:[[:space:]]*/, "", v)
      if (v ~ /^"/) { sub(/^"/, "", v); sub(/"$/, "", v); gsub(/\\"/, "\"", v) }
      return v
    }
    function flush() {
      if (mid=="" || gate=="") return
      if (result=="" || result=="NOT_RUN" || sha=="" || logh=="") return
      dest=evid "/" mid "." gate ".tsv"
      line=sha "\t" approval "\t" spec "\t" exitc "\t" result "\t" logh
      print line > (dest)
      close(dest)
    }
    /^  - milestone_id:/ { flush(); mid=$3; gate=result=sha=logh=approval=spec=exitc=""; next }
    /^    gate:/ { gate=yv(); next }
    /^    result:/ { result=yv(); next }
    /^    sha:/ { sha=yv(); next }
    /^    log_hash:/ { logh=yv(); next }
    /^    approval:/ { approval=yv(); next }
    /^    spec_hash:/ { spec=yv(); next }
    /^    exitcode:/ { exitc=yv(); next }
    END { flush() }
  ' "$f"
  for dest in "$tmpdir"/*.tsv; do
    [ -f "$dest" ] || continue
    base="${dest##*/}"
    chmod u+w "$ARCHIVE_DIR/evidence/$base" "$WORK_DIR/evidence/$base" 2>/dev/null || true
    rm -f "$ARCHIVE_DIR/evidence/$base" "$WORK_DIR/evidence/$base"
    cp "$dest" "$ARCHIVE_DIR/evidence/$base"
    cp "$dest" "$WORK_DIR/evidence/$base"
  done
  rm -rf "$tmpdir"
}

