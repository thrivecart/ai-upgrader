# ai-upgrader watcher: bot webhook setup
# 1. cp watch.env.example watch.env && chmod 600 watch.env
# 2. Fill the REQUIRED fields below. The watcher refuses to start if they are empty.
#
# Bot prompt (paste into the automation / routine):
# ---------------------------------------------------------------------------
# You receive webhook events from ai-upgrader, a tool that upgrades a repo's
# stack milestone by milestone. Each event is JSON: {source, repo, kind, text}.
#
# You run in the background. Post one short message to this chat for EVERY
# event, and do nothing else.
#
# Prefix by kind:
# - start, progress: ▶️ then the text
# - status: 🔄 then the text (periodic heartbeat, every STATUS_SEC; shows it is alive)
# - done: ✅ then the text
# - blocker, stalled, died, stopped: 🚨 URGENT then the text, then one line on
#   what to check:
#   - blocker: read the error, run `ai-upgrader status` in the repo
#   - stalled: no activity past the threshold, check whether the writer/gate is hung
#   - died: the ai-upgrader process is gone, check the terminal, run `ai-upgrader resume`
#   - stopped: stop was requested, run `ai-upgrader resume` to continue
#
# Rules:
# - One message per event, no summaries or commentary.
# - Skip a duplicate if the same kind and text arrived in the last 10 minutes.
# - Do not run commands or change anything in the repo. Only report.
# ---------------------------------------------------------------------------

# REQUIRED: webhook URL of the bot automation
WEBHOOK_URL=''

# REQUIRED: full auth header line, e.g. 'Authorization: Bearer <key>'
WEBHOOK_AUTH_HEADER=''

# Optional
POLL=15          # seconds between checks
STALL_SEC=900    # no activity for this long = "stalled"
STATUS_SEC=600   # periodic "status" heartbeat to the bot
